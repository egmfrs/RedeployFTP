      <button id="markAsLiveBtn" onclick="confirmMarkLive()">Mark as Live</button>
      <button id="markAsRolledBtn" onclick="confirmMarkRolled()">Mark as Rolled</button>
      <button id="undoMarkRolledBtn" onclick="confirmUndoMarkRolled()" style="display:none;">Undo Mark as Rolled</button>
      <button id="undoMarkLiveBtn" onclick="confirmUndoMarkLive()" style="display:none;">Undo Mark as Live</button>
