<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>RedeployFTP</title>
<hta:application id="oHTA" applicationname="RedeployLogViewer"
  icon="RedeployLogViewer.ico"
  border="thick" borderstyle="normal" caption="yes" maximizebutton="yes"
  minimizebutton="yes" showintaskbar="yes" singleinstance="yes"
  sysmenu="yes" windowstate="maximize" scroll="no" navigable="no" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<style>
  html {
    font-size: 13px;
  }
  html, body {
    margin: 0; padding: 0; height: 100%;
    font-family: Segoe UI, Tahoma, Arial, sans-serif;
    color: #222; background: #f4f4f4;
    overflow: hidden;
  }
  #header {
    height: 40px; background: #2d3e50; color: #fff;
    display: flex; align-items: center; padding: 0 12px;
    box-sizing: border-box;
  }
  #header .title { font-size: 1.15rem; font-weight: 600; flex: 0 0 auto; margin-right: 12px; }
  #header .header-spacer { flex: 1; }
  #header .path { font-size: 0.85rem; color: #b7c3cf; margin-right: 12px; }
  #header label { font-size: 0.9rem; color: #cfe0f2; margin-right: 6px; flex: 0 0 auto; }
  /* Same darker navy the rest of the app uses for a plain field (modal text inputs, an inactive
     filter/toggle button) - #3f5871 (still used by the header's own buttons) reads as an "active/
     accent" blue, which doesn't fit a plain selector field. */
  #header .project-select {
    background: #16223a; color: #fff; border: 1px solid #3a4f68;
    padding: 4px 8px; font-size: 0.9rem; max-width: 220px;
  }
  /* flexbox "gap" has no effect at all in IE11/Trident - spacing is done via margins on
     every child but the first ("> * + *") throughout this file instead. */
  .repo-root-row { display: flex; }
  .repo-root-row > * + * { margin-left: 8px; }
  .repo-root-row input { flex: 1; }
  .repo-root-row button {
    background: #3f5871; color: #fff; border: 1px solid #56728f; border-radius: 3px;
    padding: 5px 12px; cursor: pointer; font-size: 0.9rem; white-space: nowrap;
  }
  .repo-root-row button:hover { background: #4c6b89; }
  /* Two-pane split for Manage Exclusions - flex-basis calc() must be set via the LONGHAND
     properties (flex-grow/flex-shrink/flex-basis), not the "flex" shorthand: IE11/Trident
     silently drops the entire shorthand declaration when it contains calc(), falling back to
     the shorthand's own initial value (flex: 0 1 auto) instead - confirmed live earlier this
     project. The longhand form parses calc() correctly; only the shorthand's grammar chokes. */
  /* #manageExclusionsBox is now sized like #addEntryBox (95vh) rather than sizing to content, so
     everything below the subtitle needs to flex-grow to actually fill that space instead of
     leaving a wall of empty modal below a handful of short lines - same flex-column-with-one-
     growing-child approach used for #addEntryBox's own layout. */
  #manageExclusionsBox { display: flex; flex-direction: column; position: relative; }
  #manageExclusionsBox > .modal-actions { flex: 0 0 auto; justify-content: flex-end; }
  /* Small reusable "X" close button, top-right of any modal-box that opts in - only wired up on
     Manage Exclusions for now, but deliberately not ID-scoped so other modals can adopt it later
     without renaming anything. */
  .modal-close-x {
    position: absolute; top: 12px; right: 14px; width: 34px; height: 34px; line-height: 30px;
    text-align: center; font-size: 1.7rem; font-weight: 700; color: #a33; cursor: pointer;
    border-radius: 3px;
  }
  .modal-close-x:hover { background: #a33; color: #fff; }
  .exclusions-panes { display: flex; margin-top: 14px; flex: 1 1 auto; min-height: 0; }
  .exclusions-pane {
    min-width: 0; display: flex; flex-direction: column;
    border: 1px solid #e2e2e2; border-radius: 3px; padding: 10px 12px; box-sizing: border-box;
    background: #f8f9fa;
  }
  /* No calc() here (unlike the earlier 50/50 attempts elsewhere in this file), so the plain
     "flex" shorthand is safe - that IE11 bug is specifically calc()-inside-the-shorthand, not
     the shorthand itself. Standard is a fixed 20% (it's just a handful of short lines); custom
     gets whatever's left, since it's a full editor that benefits from the room. */
  .exclusions-pane-standard { flex: 0 0 20%; }
  .exclusions-pane-custom { flex: 1 1 auto; }
  .exclusions-pane + .exclusions-pane { margin-left: 16px; }
  .exclusions-pane-header {
    flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between;
    font-weight: 600; margin: 0 0 8px 0; cursor: pointer;
  }
  .exclusions-pane-header input[type="checkbox"] { width: auto; margin: 0 6px 0 0; }
  .exclusions-std-list { list-style: none; margin: 0; padding: 0; flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  .exclusions-std-item { display: flex; flex-direction: column; padding: 6px 0; border-bottom: 1px dotted #e2e2e2; }
  .exclusions-std-item:last-child { border-bottom: none; }
  .exclusions-std-pattern { font-family: Consolas, monospace; font-weight: 600; font-size: 0.85rem; }
  .exclusions-std-reason { font-size: 0.78rem; color: #888; margin-top: 2px; }
  /* wrap="off" (on the element itself) is what actually stops a textarea from soft-wrapping -
     CSS white-space alone doesn't control textarea wrapping the way it does for other elements.
     overflow-x:auto lets long lines scroll horizontally instead. flex:1 1 auto (rather than a
     fixed height) lets it fill the now much taller pane. */
  #customExclusionsText { flex: 1 1 auto; min-height: 0; resize: none; white-space: pre; overflow-x: auto; overflow-y: auto; }
  #header button {
    background: #3f5871; color: #fff; border: 1px solid #56728f;
    padding: 4px 10px; cursor: pointer; font-size: 0.92rem; margin-left: 8px;
  }
  #header button:hover { background: #4c6b89; }
  #header button.icon-btn {
    padding: 4px 8px; font-size: 1.1rem; line-height: 1; min-width: 30px; text-align: center;
  }
  /* Stats/Collapse-hidden-rows toggles have no icon swap of their own (unlike dateFlatToggleBtn),
     so without this they gave no visible sign of being on at all. */
  #header button.icon-btn.active { background: #a67c00; border-color: #c99a1f; }
  #header button.icon-btn.active:hover { background: #bf8f00; }
  #header button.icon-btn:disabled {
    background: #33475c; border-color: #445b73; color: #7488a0; cursor: default;
  }
  #header button.icon-btn:disabled:hover { background: #33475c; }
  #header button.test-deploy-btn { background: #2f6fb3; border-color: #3f7fc4; padding: 4px 10px; font-size: 0.92rem; }
  #header button.test-deploy-btn:hover { background: #3a80c9; }

  #filterBar {
    /* No fixed height any more - .pill-filter-box below can wrap onto multiple lines once
       enough file filters are added, and this needs to grow to fit rather than clipping/forcing
       a scrollbar that could hide pills, the "type and press Enter" input, or Clear all at once.
       #main's own top offset is kept in sync with however tall this actually renders - see
       layoutPanes(). align-items:flex-start (not center) so the single-line items (labels,
       buttons, the Details input) stay pinned to the top row instead of centering across the
       full grown height. */
    position: absolute; top: 40px; left: 0; right: 0; min-height: 34px;
    background: #eef1f4; border-bottom: 1px solid #ccc;
    display: flex; align-items: flex-start; padding: 6px 12px; box-sizing: border-box;
  }
  #filterBar label { font-size: 0.85rem; color: #555; margin-right: 6px; flex: 0 0 auto; }
  .live-filter-group { display: flex; margin-left: 8px; flex: 0 0 auto; }
  .live-filter-btn {
    font-size: 0.85rem; padding: 3px 8px; cursor: pointer;
    background: #fff; color: #556; border: 1px solid #bbc4cc; margin-left: -1px;
  }
  .live-filter-btn:first-child { margin-left: 0; border-radius: 3px 0 0 3px; }
  .live-filter-btn:last-child { border-radius: 0 3px 3px 0; }
  .live-filter-btn:hover { background: #eef4fa; }
  .live-filter-btn.active { background: #3f5871; color: #fff; border-color: #56728f; position: relative; z-index: 1; }
  .live-filter-btn.active:hover { background: #4c6b89; }
  /* Same shape/colors as .live-filter-btn above, scaled up to match h2.section's own font-size/
     text-transform/letter-spacing (1rem, uppercase, .05em) - this replaces what used to be a
     plain "Deployment Entries" label with a real Deployment Entries / Git Commits toggle, sized
     so the active label still reads the same size it always has. */
  .pane-view-toggle-wrap { display: flex; align-items: center; flex: 0 0 auto; }
  .pane-view-toggle-label { font-size: 0.85rem; color: #556; margin-right: 8px; white-space: nowrap; }
  .pane-view-toggle-group { display: flex; flex: 0 0 auto; }
  .pane-view-toggle-btn {
    font-size: 1rem; text-transform: uppercase; letter-spacing: .05em;
    padding: 4px 12px; cursor: pointer;
    background: #fff; color: #556; border: 1px solid #bbc4cc; margin-left: -1px;
  }
  .pane-view-toggle-btn:first-child { margin-left: 0; border-radius: 3px 0 0 3px; }
  .pane-view-toggle-btn:last-child { border-radius: 0 3px 3px 0; }
  .pane-view-toggle-btn:hover { background: #eef4fa; }
  .pane-view-toggle-btn.active { background: #3f5871; color: #fff; border-color: #56728f; position: relative; z-index: 1; }
  .pane-view-toggle-btn.active:hover { background: #4c6b89; }
  .group-option-checkbox {
    font-size: 0.85rem; color: #556; margin-left: 10px; flex: 0 0 auto;
    display: inline-flex; align-items: center; cursor: pointer; white-space: nowrap;
  }
  .group-option-checkbox input { margin-right: 4px; cursor: pointer; }
  .group-option-label {
    font-size: 0.85rem; color: #556; margin-left: 10px; flex: 0 0 auto; white-space: nowrap;
  }
  /* Direct-child combinator so this doesn't also catch the pill box's own text input, which
     is nested inside #fileFilterBox (a descendant, not a direct child of #filterBar). */
  #filterBar > input {
    font-size: 0.9rem; padding: 3px 6px; border: 1px solid #bbc4cc; border-radius: 3px;
    margin-right: 16px; box-sizing: border-box; flex: 1 1 auto; min-width: 60px;
  }
  #filterBar button { font-size: 0.85rem; padding: 3px 8px; cursor: pointer; flex: 0 0 auto; }
  /* Git View has no files/details/live-test/grouped concept of its own - hidden via a class on
     each direct child (never a wrapper span) so #filterBar's own direct-child flex layout and
     the "#filterBar > input" selector below stay intact regardless of which mode is active. The
     toggle class lives on #filterBar itself, not <body> - setDarkMode() wholesale-overwrites
     body.className ("dark"/""), which would silently wipe a body-level toggle class right back
     off the moment dark mode is switched while Git View is active. */
  #filterBar.git-active .log-only-control { display: none; }
  #filterBar .filter-mode-btn {
    min-width: 34px; text-align: center; margin-right: 8px;
    background: #3f5871; color: #fff; border: 1px solid #56728f; border-radius: 3px;
  }
  #filterBar .filter-mode-btn:hover { background: #4c6b89; }
  .pill-filter-box {
    /* flex-wrap (not overflow-x:auto) - with enough filter pills added, wrapping onto a second
       line keeps every pill, the "type and press Enter" input, and (now a plain sibling) Clear
       all visible at once, instead of some of them needing a manual horizontal scroll to reach -
       previously ALL of this box's content could end up hidden behind that scroll, not just
       Clear (which is why Clear alone being moved out wasn't the whole fix). */
    display: flex; align-items: center; flex: 1 1 auto; min-width: 60px; flex-wrap: wrap;
    min-height: 24px; border: 1px solid #bbc4cc; border-radius: 3px; background: #fff;
    padding: 2px 4px; margin-right: 8px; box-sizing: border-box;
  }
  .pill-filter-box > * { margin: 2px 4px 2px 0; }
  .filter-pill {
    display: flex; align-items: center; flex: 0 0 auto; white-space: nowrap;
    background: #dde7f0; color: #2f4a63; border-radius: 10px; padding: 1px 6px; font-size: 0.8rem;
  }
  .filter-pill > * + * { margin-left: 4px; }
  .filter-pill-x { cursor: pointer; font-weight: 700; color: #6a7f92; }
  .filter-pill-x:hover { color: #c0392b; }
  /* Edit Entry's Files pills, once test-deployed: a file that actually transferred can't be
     un-said after the fact, so its pill just shows (no × to remove it) - only a file that never
     really transfers (excluded/ignored) stays fully editable, see isEditEntryFileLocked(). */
  .filter-pill-locked { opacity: 0.6; cursor: default; }
  .pill-filter-input {
    flex: 1 1 50px; min-width: 40px; border: none; outline: none; background: transparent;
    font-size: 0.9rem; padding: 2px; box-sizing: border-box;
  }
  /* A plain sibling of #fileFilterBox now (a normal #filterBar flex item, not a child of the
     pill box) so it's never affected by however the pill box itself wraps/grows. Deliberately no
     custom look here beyond spacing - matches the Details filter's own plain Clear button
     exactly (that one has no styling beyond the generic "#filterBar button" rule either), per
     an explicit ask that the two look the same rather than one looking like a subtle link and
     the other a normal button. */
  #filterBar .pill-filter-clear { flex: 0 0 auto; margin-right: 16px; }
  /* Obvious-at-a-glance indicator that a filter is actively narrowing the list - toggled by
     onFilterChanged() whenever either filter has real content. */
  .pill-filter-box.filter-has-content { background: #fff6cf; border-color: #d9b93c; }
  #detailFilterInput.filter-has-content { background: #fff6cf; border-color: #d9b93c; }
  #resultCount {
    flex: 0 0 auto; margin-left: 12px; font-size: 0.85rem; color: #45566b;
    font-weight: 600; white-space: nowrap;
  }

  #main { position: absolute; top: 74px; left: 0; right: 0; bottom: 0; }

  #listPane {
    position: absolute; top: 0; bottom: 0; left: 0; width: 33%;
    min-width: 220px; max-width: 75%;
    border-right: 1px solid #ccc; background: #fff;
    box-sizing: border-box;
    display: flex; flex-direction: column;
  }
  /* Right padding is 12px (matching every other side) PLUS 17px reserved to match #list's own
     scrollbar gutter below - #list always shows its scrollbar (overflow-y:scroll, not auto) for
     exactly this reason: without a constant, always-reserved gutter, this header's content would
     sit flush against the panel's true right edge while the rows below stop 17px short of it
     (where their scrollbar sits), so the header visibly overshot the rows' own right edge by
     that same amount. Reserving the gutter here keeps both aligned regardless of whether #list's
     content is currently tall enough to need scrolling. */
  #listPane .pane-header-row { flex: 0 0 auto; padding: 8px 29px 6px 12px; }
  .pane-header-right-group { display: flex; align-items: center; gap: 8px; }
  .pane-icon-btn {
    background: #eef2f7; color: #45566b; border: 1px solid #cdd6e0; border-radius: 3px;
    padding: 3px 8px; font-size: 1rem; line-height: 1; cursor: pointer; text-align: center;
  }
  .pane-icon-btn:hover { background: #dde6f0; }
  body.dark .pane-icon-btn { background: #1e2f48; color: #b9c8da; border-color: #3a4f68; }
  body.dark .pane-icon-btn:hover { background: #26374f; }
  #list {
    flex: 1 1 auto; min-height: 0; overflow-y: scroll; box-sizing: border-box;
    -ms-user-select: none; -webkit-user-select: none; user-select: none;
  }
  #resizer {
    position: absolute; top: 0; bottom: 0; left: 33%; width: 5px;
    cursor: col-resize; background: #ddd;
  }
  #resizer:hover { background: #bbb; }

  #detailsPane {
    position: absolute; top: 0; height: 64%; left: calc(33% + 5px); right: 0;
    overflow-y: auto; padding: 14px 18px; box-sizing: border-box;
    background: #fff;
  }
  #vresizer {
    position: absolute; top: 64%; height: 5px; left: calc(33% + 5px); right: 0;
    cursor: row-resize; background: #ddd;
  }
  #vresizer:hover { background: #bbb; }
  #filesPane {
    position: absolute; top: calc(64% + 5px); bottom: 0; left: calc(33% + 5px); right: 0;
    overflow-y: auto; padding: 10px 18px; box-sizing: border-box;
    background: #fafbfc;
  }
  /* Two genuinely independent frames side by side (not one shared header) - each column owns
     its own .pane-header-row, so "Files"/"Entries" line up at the same height without either
     nesting under the other. */
  .files-pane-columns { display: flex; }
  /* flex-basis:0 (not auto) - measured live: with auto, IE11 was sizing this to its own
     min-content width (the longest filename's intrinsic width, ignoring min-width:0 entirely)
     instead of shrinking to the space left over after .entries-group-col, pushing Entries off
     the edge of the pane and forcing the whole row into horizontal scroll. Starting from 0 and
     growing via flex-grow sidesteps that content-based sizing bug outright - a smaller, simpler
     fix than the fixed-px-with-JS-measurement pattern used elsewhere in this app for the same
     class of IE11 quirk (see .test-deploy-backup-col's own comment). */
  .files-pane-list-col { flex: 1 1 0%; min-width: 0; }
  /* Shrink-to-fit (not a fixed %) - just wide enough for "Grouped (N)" + the button on one line
     and the widest "#NNN" row, so Files keeps as much width as possible. white-space:nowrap on
     the text-bearing bits is the actual thing stopping the count from wrapping to its own line;
     the flex-basis:auto is what lets the column shrink down to that content width instead of
     claiming a fixed share it doesn't need. */
  .entries-group-col {
    flex: 0 0 auto; border-left: 1px solid #e2e2e2; padding-left: 12px; margin-left: 12px;
  }
  .entries-group-col .pane-header-row h2.section { white-space: nowrap; }
  .entries-group-list { list-style: none; margin: 0; padding: 0; }
  .entries-group-list li { font-size: 0.9rem; padding: 3px 0; color: #444; white-space: nowrap; }
  .entries-group-list li.current-entry { font-weight: 700; display: flex; align-items: center; }
  .entries-inline-detach-btn { margin-left: 10px; padding: 1px 8px; font-size: 0.72rem; }
  #groupBtn:disabled, .entries-inline-detach-btn:disabled { opacity: 0.5; cursor: default; }
  body.dark .entries-group-col { border-left-color: #2c3e54; }
  body.dark .entries-group-list li { color: #dfe4ea; }

  /* Shown only once a file is selected (single click) in the Files list below - see
     selectFilesPaneFile(). Double-click still does the old "add to file filter" behaviour. */
  /* flex-wrap so a narrower window wraps extra buttons onto a second line instead of silently
     clipping them past the pane's right edge (same fix Phase 21 already applied to the file-
     filter pill box for the identical complaint) - the containing .pane-header-row has no fixed
     height, so it grows to fit a wrapped second line with no further changes needed. A plain
     margin-bottom on every button (not flexbox row-gap, which IE11/Trident doesn't support at
     all) gives consistent vertical spacing whether wrapped or not. */
  .files-action-bar { display: flex; align-items: center; flex-wrap: wrap; }
  .files-action-bar > * + * { margin-left: 6px; }
  .files-action-btn { font-size: 0.75rem; padding: 3px 8px; margin-bottom: 4px; }
  .files-action-btn:disabled { opacity: 0.5; cursor: default; }
  #filesBody li.files-pane-row-selected { background: #cfe4f7; }
  body.dark #filesBody li.files-pane-row-selected { background: #2f4a6b; }

  .date-header {
    background: #eef2f7; color: #223247; font-weight: 700; font-size: 0.85rem;
    padding: 6px 12px; border-bottom: 3px solid #2f6fb3;
    display: flex; justify-content: space-between; align-items: center;
  }
  .date-header-stats { font-weight: 700; color: #5e7a91; margin-left: 12px; white-space: nowrap; }

  .row {
    padding: 6px 12px; border-bottom: 1px solid #eee; cursor: pointer;
    /* Left-edge accent bar (colour/style set inline per-row by renderList(), see accentStyleFor())
       - box-sizing so the border sits inside the row's existing width instead of adding to it,
       matching #list's own box-sizing:border-box convention. Transparent by default (no group). */
    border-left: 8px solid transparent; box-sizing: border-box;
  }
  .row:hover { background: #eef4fa; }
  .row.selected { background: #cfe4f7; }
  /* Text colour only, deliberately no background - a background fill read as "this looks
     selected too", which is wrong (only the row you actually clicked is selected; group-mates
     are just related to it). Red in light mode; the dark-mode override further down uses yellow
     instead (explicitly asked for, not just "the same red on a dark background"). */
  .row.entry-grouped .row-id, .row.entry-grouped .row-summary { color: #c0392b; }
  /* Git View only - every commit that went live in the same batch as the one actually clicked,
     shown alongside it via .row.selected's own background; orange (not entry-grouped's red, which
     already means something else here - the Live tick) so "this rode along too" reads as its own
     distinct signal. */
  .row.git-batch-sibling .row-id, .row.git-batch-sibling .row-summary { color: #c26f00; }
  .row-line1, .row-line2 { display: flex; align-items: center; }
  .row-line1 { margin-bottom: 3px; }
  .row-id { font-weight: 700; font-size: 0.85rem; color: #7a8794; flex: 0 0 auto; margin-right: 8px; }
  /* Git View only - per-author initials badge, coloured via assignGitAuthorColors(). */
  .git-author-circle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%; color: #fff; font-size: 0.62rem; font-weight: 700;
    margin-right: 6px; flex: 0 0 auto; letter-spacing: -0.03em;
  }
  /* Git View Details pane - the commit's subject line (line one), rendered as its own plain
     heading rather than another bullet in the list below it. */
  .git-commit-subject { font-weight: 700; margin-bottom: 6px; }
  /* Git View only - clickable #tag spans, added post-render by linkifyHashtagsInContainer().
     Never applied to the deploy log's own Details pane. */
  .git-hashtag-link { color: #2f6fb3; cursor: pointer; }
  .git-hashtag-link:hover { text-decoration: underline; }
  body.dark .git-hashtag-link { color: #6fa8dc; }
  .badge {
    font-size: 0.77rem; font-weight: 700; padding: 1px 6px; border-radius: 3px;
    letter-spacing: .03em; white-space: nowrap; flex: 0 0 auto; margin-right: 8px;
  }
  .badge-pending { background: #f7d774; color: #6b5100; }
  .badge-rolled { background: #e2e2e2; color: #666; }
  .badge-test { background: #6fbf82; color: #0d3d1c; }
  .badge-git { background: #dbe7f4; color: #234b73; }
  /* Collapsed view's own badge for a run whose members don't all share one badge state - a
     dashed border (rather than another solid fill) reads as "not a real single state" at a glance. */
  .collapsed-count-pill {
    display: inline-block; background: #ffff00; color: #000; font-weight: 700; font-size: 0.72rem;
    padding: 1px 6px; border-radius: 3px; margin-left: 4px; font-family: Segoe UI, Tahoma, Arial, sans-serif;
  }
  .row-summary {
    color: #555; font-size: 0.96rem; flex: 1 1 auto; min-width: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .file-badges { white-space: nowrap; overflow: hidden; min-height: 17px; flex: 1 1 auto; min-width: 0; }
  .file-badge {
    display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 0.7rem;
    font-family: Consolas, monospace; color: #fff; margin-right: 4px; white-space: nowrap;
    cursor: pointer;
  }
  .file-badge:hover { outline: 1px solid rgba(255,255,255,0.7); }
  .file-badge.deleted { opacity: 0.75; }
  .file-badge.more-badge { background: #98a2ad; color: #fff; font-family: Segoe UI, Tahoma, Arial, sans-serif; font-weight: 700; cursor: default; }
  .file-badge.more-badge:hover { outline: none; }
  /* Main-list row's cross-group conflict indicator (see appendRowConflictIndicators() /
     computeCrossGroupFileConflicts()) - a plain presence flag on the row itself, sized to match
     the tick it sits beside, not tied to any one file pill's own colour. */
  .row-conflict-later, .row-conflict-earlier {
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
    min-width: 15px; height: 15px; border-radius: 3px; padding: 0 3px; margin-left: 4px;
    font-size: 9px; font-weight: 700; color: #fff; cursor: default;
  }
  .row-conflict-later { background: #2f6fb3; }
  .row-conflict-earlier { background: #c0392b; }
  /* Phase 55's weaker-confidence tier (either side of the match is a data-row filename guess) -
     amber, same colour this app already uses for "needs-changes"/soft-warning states elsewhere,
     so it reads as "plausible false alarm" rather than a hard, confident conflict. */
  .row-conflict-later.db-conflict-weak, .row-conflict-earlier.db-conflict-weak { background: #a67c00; }
  /* DB Scripts panel's own "honor the exception" treatment (shares this pill's classes with the
     main-list row indicator above) - grey background once EVERY id behind this pill has been
     whitelisted (see appendDbObjectConflictIndicator()'s buildArrow()); a strikethrough on any one
     dismissed id within .db-conflict-nums below, regardless of which exception state it is - that
     list is already plain muted text with no colour of its own to override. */
  .row-conflict-later.conflict-exception-grey, .row-conflict-earlier.conflict-exception-grey { background: #888; }
  .db-conflict-wrap { display: inline-flex; align-items: center; margin-left: 6px; flex-wrap: wrap; }
  .db-conflict-nums { font-size: 0.78rem; color: #555; margin-left: 2px; margin-right: 4px; }
  .db-conflict-nums .conflict-exception-struck { text-decoration: line-through; color: #999; }
  /* appendDbConflictDetail()'s own path text (inline single-conflict case, and each "more info"
     dropdown row) - same already-muted-text reasoning as .db-conflict-nums above. */
  .db-conflict-path.conflict-exception-struck { text-decoration: line-through; }
  /* The "more info" dropdown's own "Later: #NNN"/"Earlier: #NNN" head label - the actual
     whitelisting action lives as buttons inside appendDbConflictDetail() below it, so this is a
     read-only reflection of the same state, not a second click target of its own. */
  .db-conflict-menu-head.conflict-exception-struck { text-decoration: line-through; color: #999; }
  /* overflow-wrap:break-word - a real relpath has no spaces to wrap at, so plain white-space:normal
     on the row below isn't enough on its own; without this the path just overflows straight past
     the menu's own 420px background instead of wrapping onto a second line. */
  .db-conflict-path { font-size: 0.76rem; color: #888; font-style: italic; margin-right: 4px; display: inline-block; overflow-wrap: break-word; word-break: break-all; max-width: 100%; }
  /* The leading segments the two paths actually share (almost always just .dbScripts/dbUpdates/,
     since this feature only ever compares two dbUpdates files) stay plain weight; the part that
     actually differs - and the filename, always, on its own line - is bold so it's what the eye
     lands on first. */
  .db-conflict-path-diverge { font-weight: 700; }
  .db-conflict-small-btn { font-size: 0.72rem; padding: 1px 6px; margin-right: 4px; }
  .db-conflict-more-link { font-size: 0.78rem; margin-right: 6px; }
  .db-conflict-menu { max-width: 640px; }
  .db-conflict-menu-title {
    font-weight: 700; font-size: 0.85rem; padding: 8px 14px 6px; cursor: default;
    border-bottom: 1px solid #ddd;
  }
  /* Two classes, not one, so this beats .adhoc-compare-menu-item's own white-space:nowrap - same
     specificity otherwise, and that rule is declared later in this stylesheet. */
  .adhoc-compare-menu-item.db-conflict-menu-row { white-space: normal; display: block; padding: 6px 14px; overflow-wrap: break-word; }
  .adhoc-compare-menu-item.db-conflict-menu-row:hover { background: inherit; cursor: default; }
  .db-conflict-menu-head { font-weight: 700; font-size: 0.82rem; margin-bottom: 3px; }

  .deploy-tick {
    flex: 0 0 auto; width: 15px; height: 15px; border-radius: 50%;
    margin-left: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700; box-sizing: border-box;
  }
  .deploy-tick.not-live { border: 2px solid #c0392b; background: transparent; }
  .deploy-tick.ready-for-live { border: 2px solid #2a7a3d; background: transparent; }
  .deploy-tick.needs-changes { border: 2px solid #a67c00; background: transparent; }
  .deploy-tick.is-live { background: #c0392b; color: #fff; border: 2px solid #c0392b; }
  .deploy-tick.is-rolled { background: #999; color: #fff; border: 2px solid #999; }
  .deploy-tick.superseded-pre-test { background: #fff; color: #aaa; border: 2px solid #ccc; cursor: default; }
  .deploy-tick.tick-mixed { background: transparent; border: 2px dashed #999; cursor: default; }

  .showmore-row { display: flex; align-items: center; justify-content: center; position: relative; margin: 14px 0; }
  .showmore-btn {
    display: inline-block; padding: 6px 16px; cursor: pointer;
    background: #3f5871; color: #fff; border: 1px solid #56728f; border-radius: 4px; font-size: 0.9rem;
  }
  .showmore-btn:hover { background: #4c6b89; }
  .showmore-all-link { position: absolute; right: 12px; font-size: 0.8rem; }

  /* One line standing in for a run of rows hidden by the Live/Test filter - deliberately inert
     (no click behaviour, not selectable) and visually much quieter than a real .row, so it never
     gets mistaken for an actual entry. Background sits between .row (white) and .date-header
     (#eef2f7) - noticeably a break in the flow, but clearly not a date boundary. */
  .hidden-items-placeholder {
    padding: 4px 12px; font-size: 0.82rem; font-style: italic; color: #8a97a6; text-align: center;
    background: #f6f8fa; border-bottom: 1px solid #eee; cursor: default;
  }
  /* "Collapse to compact" option (toggleHiddenPlaceholderCompact()) - same slot, no text, just a
     thin double-dashed strip standing in for the same information (full count still on hover via
     the element's title) when even the one-line text form is more than wanted. */
  .hidden-items-placeholder.compact {
    padding: 0; height: 5px; font-size: 0; line-height: 0; overflow: hidden;
    border-top: 2px dashed #b7c2cc; border-bottom: 2px dashed #b7c2cc; background: #f6f8fa;
  }

  h2.section {
    font-size: 1rem; text-transform: uppercase; letter-spacing: .05em;
    color: #888; margin: 0 0 8px 0; border-bottom: 1px solid #e2e2e2; padding-bottom: 4px;
  }
  .pane-header-row {
    display: flex; justify-content: space-between; align-items: center;
    margin: 0 0 8px 0; border-bottom: 1px solid #e2e2e2; padding-bottom: 4px;
  }
  .pane-header-row h2.section { margin: 0; border-bottom: none; padding-bottom: 0; }
  .pane-count { font-weight: 400; text-transform: none; letter-spacing: normal; color: #aaa; margin-left: 6px; }
  .test-deploy-btn {
    background: #2f6fb3; color: #fff; border: 1px solid #3f7fc4; border-radius: 3px;
    padding: 3px 10px; font-size: 0.8rem; cursor: pointer; text-transform: none; letter-spacing: normal;
  }
  .test-deploy-btn:hover { background: #3a80c9; }
  .test-deploy-btn:disabled { opacity: 0.5; cursor: default; background: #2f6fb3; }
  .delete-entry-btn { background: #a33; border-color: #c04a4a; }
  .delete-entry-btn:hover { background: #b84040; }
  .live-options-btn { background: #8c3f3f; border-color: #a85656; }
  .live-options-btn:hover { background: #a04949; }
  .live-options-btn:disabled { opacity: 0.5; cursor: default; background: #8c3f3f; }
  .live-options-wrap { position: relative; display: inline-block; }

  .deploy-progress-wrap {
    background: #e6e9ec; border-radius: 4px; height: 18px; margin: 8px 0 12px 0; overflow: hidden;
  }
  .deploy-progress-fill {
    background: #2f6fb3; color: #fff; height: 100%; width: 0%; font-size: 0.7rem; font-weight: 700;
    text-align: center; line-height: 18px; white-space: nowrap; transition: width 0.25s ease;
  }
  #deploySummary { font-size: 0.88rem; color: #555; margin-bottom: 6px; }
  .deploy-file-list {
    list-style: none; margin: 0 0 10px 0; padding: 0; max-height: 140px; overflow-y: auto;
    border: 1px solid #e2e2e2; border-radius: 3px;
  }
  .deploy-file-list li {
    font-family: Consolas, monospace; font-size: 0.85rem; padding: 6px 8px;
    border-bottom: 1px solid #eee; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    background: #fafbfc;
  }
  .deploy-file-list li:last-child { border-bottom: none; }
  .deploy-suggestion-item.selected { background: #cfe4f7; }
  .deploy-status-pending { color: #888; }
  .deploy-status-sent, .deploy-status-deleted, .deploy-status-backed-up { color: #2a7a3d; }
  .deploy-status-failed { color: #c0392b; font-weight: 700; }
  .deploy-status-not-on-server { color: #999; font-style: italic; }
  .deploy-status-excluded { color: #8a6d3b; font-style: italic; }
  .deploy-log {
    background: #f4f6f8; border: 1px solid #dde3e8; border-radius: 3px; padding: 6px 8px;
    font-family: Consolas, monospace; font-size: 0.75rem; white-space: pre-wrap;
    max-height: 140px; overflow-y: auto; color: #444;
  }
  .test-deploy-box { width: 840px; position: relative; }
  /* Viewport-relative, not a fixed px cap - grows with the window instead of stopping at an
     arbitrary height, while still bounded so a huge file list can't push the box off-screen.
     Applies to both the pre-deploy file list and the in-progress/status list (same visual slot,
     swapped out by runTestDeploy()) so the box is "automatically tall" in both phases, not just
     once the Backup & Compare panel (which has its own separate 78vh sizing) is opened. */
  #deployFilesList, #deployStatusList { max-height: 60vh; }
  .test-deploy-box.wide {
    width: 1400px; height: 78vh; box-sizing: border-box;
    display: flex; flex-direction: column;
  }
  .test-deploy-box.wide #testDeployBody { flex: 1 1 auto; min-height: 0; display: flex; }
  .test-deploy-columns { display: flex; width: 100%; min-height: 0; }
  .test-deploy-main-col { flex: 0 0 380px; min-width: 0; box-sizing: border-box; }
  .test-deploy-box.wide .test-deploy-main-col { overflow-y: auto; padding-right: 18px; }
  .test-deploy-backup-col {
    display: none; flex-direction: column; min-width: 0; min-height: 0; box-sizing: border-box;
    border-left: 1px solid #e2e2e2; padding-left: 18px;
  }
  /* min-height:0 above - the same IE11 quirk documented below for the WIDTH axis (a flex item
     that's also a flex container not shrinking to its available space) applies just as much to
     HEIGHT: without it, a long Backup & Compare file list made this column (and therefore the
     whole 78vh-capped modal) grow to fit its content instead of scrolling internally, tall enough
     to push the Deploy/Cancel buttons off the bottom of the screen with no way to reach them.
     min-height:0 alone did not fix it - confirmed live twice over (once with a 60-file synthetic
     batch, once against the user's own real ~18-file session) - #backupStatusList still rendered
     at full un-scrolled content height regardless. A follow-up attempt to live-measure the real
     available space in JS and set an explicit inline max-height (mirroring how the WIDTH fix
     below works) also failed to reproduce reliably in the user's own real session despite passing
     cleanly in every synthetic reproduction tried - never fully root-caused. Replaced with the
     same simple, already-proven-reliable mechanism this exact modal already uses for its OTHER
     long list (#deployFilesList/#deployStatusList's own plain `max-height: 60vh` - see that
     rule's own comment) instead of continuing to chase IE11's flex/JS-measurement behaviour:
     #backupStatusList below gets a plain `calc(78vh - 380px)` max-height - no flex-shrink
     dependency, no JS measurement, so nothing left to be unreliable. 380px is a deliberately
     generous, hand-estimated allowance for everything else inside the 78vh box (title, intro
     text, diff-tool row, backup buttons row, modal padding, the actions row itself) - erring
     toward a shorter list (harmless - it just scrolls a bit sooner) rather than risking the
     original overflow recurring a third time.
     Fixed px width, not flex:1 1 auto - IE11 doesn't reliably shrink a flex item that's also a
     flex container (this column) down to its available space when its own children are wide
     text/lists, even with min-width:0 on every level; the column kept rendering at its content's
     preferred width (~1443px) instead of the ~948px actually available, pushing the panel off
     the right edge of the (fixed 1400px) modal. 948px = modal's content width (1400 - 2*36px
     padding = 1328px) minus .test-deploy-main-col's fixed 380px. 929px (948 - the column's own
     18px padding-left + 1px border-left) because IE11's flex-basis calc adds that padding/border
     back on top of the declared width even with box-sizing:border-box set - measured live: a
     flex-basis of 948px rendered an outer width of 967px (948 + 19), so this compensates. */
  .test-deploy-box.wide .test-deploy-backup-col.expanded {
    display: flex; flex: 0 0 929px; width: 929px;
  }
  body.dark .test-deploy-backup-col { border-left-color: #2c3e54; }

  .backup-compare-toggle { display: inline-block; margin-bottom: 6px; }
  /* min-width:0 needed on top of flex:0 0 auto - IE11's flex items default to never shrinking
     narrower than their content's unwrapped intrinsic width (unlike modern browsers, which use
     the content's min-content size), so without it this paragraph renders as one long unbroken
     line and spills out past the column/modal instead of wrapping. Same fix applied below to
     #backupStatusList so its long filenames truncate via ellipsis instead of forcing it wider. */
  .backup-compare-intro { font-size: 0.82rem; color: #666; margin: 4px 0 8px 0; flex: 0 0 auto; min-width: 0; }
  .diff-tool-row { display: flex; align-items: center; margin-bottom: 8px; flex: 0 0 auto; align-self: flex-start; }
  .diff-tool-row span { font-size: 0.8rem; color: #666; margin-right: 6px; white-space: nowrap; }
  body.dark .diff-tool-row span { color: #8a97a6; }
  .diff-tool-select { font-size: 0.8rem; padding: 2px 4px; }
  .diff-tool-select option:disabled { color: #999; }
  /* align-self:flex-start on the row (not align-items on the flex-column parent, which would
     also shrink the file list and intro/status text to content-width) stops it stretching to the
     full column width (the default "stretch" was making things look oversized/wrong) -
     .test-deploy-btn (same class Edit Entry/Duplicate Entry/Deploy to Test use) gives both
     buttons the app's normal blue action-button look instead of unstyled native buttons. */
  .backup-btn-row { display: flex; align-items: center; margin-bottom: 8px; flex: 0 0 auto; align-self: flex-start; }
  .backup-btn-row button { margin-right: 8px; }
  #backupAllBtn:disabled, #backupCompareAllBtn:disabled { opacity: 0.5; cursor: default; }
  #backupStatusList { flex: 1 1 auto; min-height: 0; min-width: 0; max-height: calc(78vh - 380px); }
  .backup-status-list li { display: flex; align-items: center; justify-content: space-between; }
  .compact-file-list li { padding: 2px 8px; }
  .backup-status-file { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }
  .backup-status-actions { flex: 0 0 auto; display: flex; align-items: center; }
  .backup-row-btn { font-size: 0.72rem; padding: 2px 8px; margin-right: 10px; }
  .backup-row-btn:disabled { opacity: 0.4; cursor: default; }
  .backup-status-actions label { font-size: 0.72rem; color: #666; display: flex; align-items: center; cursor: pointer; white-space: nowrap; }
  #backupStatusList input[type="checkbox"], #prepareLiveBackupList input[type="checkbox"] { width: 18px; height: 18px; margin: 0 5px 0 0; cursor: pointer; }
  #backupCompareStatus { font-size: 0.8rem; color: #666; margin-top: 4px; flex: 0 0 auto; }
  #testDeployGoBtn, #testDeployCancelBtn {
    flex: 0 0 auto; padding: 5px 14px; font-size: 0.82rem; color: #fff; border-radius: 3px; cursor: pointer;
  }
  #testDeployGoBtn { background: #2f6fb3; border: 1px solid #3f7fc4; }
  #testDeployGoBtn:hover { background: #3a80c9; }
  #testDeployGoBtn.backup-verified-go-btn { background: #2a7a3d; border-color: #368f4c; }
  #testDeployGoBtn.backup-verified-go-btn:hover { background: #32924a; }
  #testDeployCancelBtn { background: #a33; border: 1px solid #c04a4a; }
  #testDeployCancelBtn:hover { background: #b84040; }
  .backup-verified-label { display: none; font-size: 0.85rem; color: #2a7a3d; font-weight: 600; margin-left: 10px; }
  body.dark .backup-verified-label { color: #4caf6a; }
  #detailsMeta { font-size: 0.92rem; color: #666; margin-bottom: 10px; }
  #detailsMeta span { margin-right: 16px; }
  .meta-row-flex { display: flex; justify-content: space-between; align-items: baseline; }
  /* Same reasoning as #detailsActions above - never shrink narrower than natural content width,
     and never let the "Live Options" button's own label wrap. */
  .meta-row-right-wrap { display: flex; align-items: baseline; gap: 10px; flex: 0 0 auto; white-space: nowrap; }
  .meta-row-right-wrap button.test-deploy-btn { padding: 3px 16px; }
  #detailsMeta .meta-live-prefix { color: #666; font-weight: 600; margin-right: 0; }
  #detailsMeta .meta-live-value { color: #c0392b; font-weight: 700; margin-right: 0; }
  .group-summary-input {
    flex: 1 1 auto; margin-left: 8px; padding: 2px 6px; font-size: 0.85rem;
    border: 1px solid #ccc; border-radius: 4px; background: #fff; color: #333;
  }
  #detailsBody ul, #detailsBody ol { margin: 4px 0; padding-left: 20px; }
  #detailsBody .detail-sub-list { margin-top: 2px; }
  #detailsBody li { margin-bottom: 5px; line-height: 1.4; font-size: 1rem; }
  #detailsBody { white-space: normal; }

  .multi-entry { margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e2e2e2; }
  .multi-entry:last-child { border-bottom: none; }
  .multi-entry-head { display: flex; align-items: center; margin-bottom: 6px; }
  .multi-entry-date { flex: 1; font-size: 0.9rem; color: #556; margin: 0 10px; }

  #filesBody { list-style: none; margin: 0; padding: 0; min-width: 0; }
  #filesBody li {
    padding: 3px 6px; border-bottom: 1px dotted #e2e2e2; font-family: Consolas, monospace;
    font-size: 0.96rem; cursor: pointer;
    /* Without this, ctrl+click/shift+click (needed for multi-select - see
       handleFilesPaneRowClick()) triggers the browser's own native text-selection behaviour on
       the second click instead of just registering as a click, highlighting the row's text like a
       click-drag would. -ms-user-select is the one that actually matters in this IE11/Trident
       host; the rest are harmless no-ops here, kept for clarity/portability. */
    -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none;
  }
  #filesBody li:hover { background: #eef4fa; }
  .files-pane-row {
    /* Flex row of [truncating name wrapper] + [non-shrinking trailing content, e.g. the cross-
       group/cross-entry conflict ▲/▼ flags] - a long path can only ever eat into the wrapper's own
       space, never push a trailing flag behind the ellipsis the way one flat truncating block
       could. Deliberately a <div> inside the <li>, not display:flex on the <li> itself - confirmed
       live that this exact engine never actually applies display:flex to a <li> element (computed
       display stays "list-item" regardless of the CSS); the identical rule on a plain <div> works
       correctly. */
    display: flex; align-items: center;
  }
  .files-pane-name-wrap {
    /* A long unbroken path (no spaces - common for the .dbScripts/... SQL filenames) has no
       natural break point, so without this it neither wraps nor scrolls cleanly - it just
       forces the row (and the whole Files column) wider, shoving Joined Entries off the edge of
       the pane. Truncating with an ellipsis instead keeps every row exactly one line, icon
       included, regardless of filename length. flex:1 1 0% (not auto) - this exact app's own
       established IE11 gotcha, a bare unitless 0 flex-basis silently fails to parse here. This is
       a plain block, not itself a flex container, so the separate "nested flex container won't
       shrink" IE11 quirk documented elsewhere in this file doesn't apply to it. */
    display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1 1 0%; min-width: 0;
  }
  /* Everything appended straight onto .files-pane-row (not into the name wrapper above) is meant
     to stay fully visible regardless of how much the wrapper truncates - today that's only the
     cross-group/cross-entry conflict flags (appendCrossGroupConflictFlagsToFilesPane()/
     appendDbObjectConflictFlagsToFilesPane()). */
  #filesBody li .files-pane-conflict-later, #filesBody li .files-pane-conflict-earlier { flex: 0 0 auto; }
  #filesBody .folder-part { color: #a3a3a3; }
  #filesBody .file-count { font-family: Segoe UI, Tahoma, Arial, sans-serif; font-weight: 700; color: #556; margin-right: 4px; font-size: 0.85rem; }
  #filesBody li .tag {
    font-family: Segoe UI, Tahoma, Arial, sans-serif; font-size: 0.77rem; font-weight: 700;
    color: #a33; margin-right: 6px; text-decoration: none; display: inline-block;
  }
  #filesBody li .files-pane-excl-tag { color: #b8860b; }
  #filesBody li.std-excluded .files-pane-name { font-style: italic; color: #8a6d3b; }
  #filesBody li .files-pane-cherry-note { color: #7a9c3f; font-size: 0.85rem; }
  #filesBody li.reverted .files-pane-name, #filesBody li.reverted .folder-part { color: #c0392b; }
  #filesBody li .files-pane-reverted-note { color: #c0392b; font-size: 0.85rem; }
  #filesBody li .files-pane-superseded-flag { color: #c0392b; font-weight: 700; margin-left: 3px; cursor: default; }
  #filesBody li .files-pane-conflict-later { color: #2f6fb3; font-weight: 700; margin-left: 4px; cursor: default; }
  #filesBody li .files-pane-conflict-earlier { color: #c0392b; font-weight: 700; margin-left: 4px; cursor: default; }
  /* The arrow stays plain (cursor:default above still applies to it); only the "#NNN" itself is a
     real link - underlined so it reads as clickable regardless of hover, pointer cursor on top. */
  #filesBody li .entry-id-link { cursor: pointer; text-decoration: underline; }
  /* "There's at least one more behind this one" - now a real link (showConflictMoreMenu()), styled
     the same clickable way .entry-id-link already is. */
  #filesBody li .db-conflict-more-indicator { margin-left: 1px; cursor: pointer; text-decoration: underline; }
  /* The full-list submenu's own colored #NNN ids (showConflictMoreMenu()) - same blue/red hues as
     .files-pane-conflict-later/-earlier above, but unscoped since this menu is appended to
     document.body, not inside #filesBody li. */
  .conflict-more-menu-later { color: #2f6fb3; font-weight: 700; }
  .conflict-more-menu-earlier { color: #c0392b; font-weight: 700; }
  /* Phase 55's weaker-confidence tier - same amber as .db-conflict-weak, "plausible false alarm". */
  #filesBody li .files-pane-conflict-later.files-pane-conflict-weak, #filesBody li .files-pane-conflict-earlier.files-pane-conflict-weak { color: #a67c00; }
  /* A reviewed-and-dismissed flag stays visible (never removed outright, unlike a drop/DELETE:/
     missing-file exclusion) - "not related" keeps its own colour (weak/amber only - the option is
     only ever offered on a weak flag to begin with) but strikes it through; "not in conflict" goes
     grey instead, overriding whatever colour (blue/red/amber) it would otherwise have had. */
  #filesBody li .conflict-exception-struck { text-decoration: line-through; }
  /* Two classes, not one, so this beats .files-pane-conflict-later/-earlier's own colour on real
     specificity rather than source order - the same class of bug this app hit once already with
     .adhoc-compare-menu-item's white-space:nowrap silently beating an intended override. */
  #filesBody li .files-pane-conflict-later.conflict-exception-grey,
  #filesBody li .files-pane-conflict-earlier.conflict-exception-grey { color: #999; }
  .ext-icon {
    /* flex-shrink:0 - a direct child of a flex row (.git-file-list li, .files-to-deploy-item)
       becomes a flex item regardless of its own display value, and flex items default to
       flex-shrink:1 even with an explicit width - so without this, a long nowrap filename
       fighting for space would squash the icon down from its fixed 14px instead of the
       filename's own ellipsis/truncation doing the work. */
    display: inline-block; width: 14px; height: 14px; line-height: 14px; text-align: center;
    font-size: 8px; font-weight: 700; color: #fff; border-radius: 2px; margin-right: 6px;
    vertical-align: middle; font-family: Segoe UI, Tahoma, Arial, sans-serif;
    flex-shrink: 0; flex-grow: 0;
  }

  #empty { padding: 40px; color: #888; text-align: center; }

  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45);
    display: none; align-items: center; justify-content: center; z-index: 1000;
  }
  #markLiveOverlay { justify-content: flex-start; }
  .modal-box {
    background: #fff; border-radius: 6px; padding: 30px 36px; width: 680px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35); box-sizing: border-box;
  }
  .modal-box h3 { margin: 0 0 15px 0; font-size: 1.05rem; }
  .modal-box label { display: block; margin: 15px 0 6px 0; font-size: 0.9rem; color: #555; }
  /* Checkboxes/radios excluded - this rule (width:100%, padding, border) was silently
     hitting them too since it didn't check type, stretching each one to full row width and
     pushing its label text to wrap - looked like "right-aligned text, centered checkboxes". */
  .modal-box input:not([type="checkbox"]):not([type="radio"]), .modal-box textarea {
    width: 100%; box-sizing: border-box; padding: 8px 10px; font-size: 0.95rem;
    border: 1px solid #bbc4cc; border-radius: 3px;
  }
  .modal-box input[type="checkbox"], .modal-box input[type="radio"] { width: auto; margin: 0; }
  .modal-box textarea { font-family: Consolas, monospace; resize: vertical; }
  .add-project-ftp-hint { margin: 15px 0 0 0; font-size: 0.8rem; color: #888; line-height: 1.4; }
  .add-project-ftp-heading { margin: 15px 0 0 0; font-size: 0.85rem; color: #555; border-top: 1px solid #e2e2e2; padding-top: 12px; }
  body.dark .add-project-ftp-hint { color: #8a97a6; }
  body.dark .add-project-ftp-heading { color: #b9c8da; border-top-color: #2c3e54; }
  .modal-box textarea[readonly] { background: #f0f0f0; color: #888; }
  .paths-group-title {
    margin: 18px 0 6px 0; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; color: #556; border-top: 1px solid #e2e2e2; padding-top: 10px;
  }
  #pathsAppSection, .paths-group-title:first-child { margin-top: 0; border-top: none; padding-top: 0; }
  .paths-row { display: flex; align-items: center; margin: 5px 0; }
  .paths-row .group-info-icon { flex: 0 0 auto; margin-right: 8px; }
  .paths-row-label { flex: 0 0 330px; font-size: 0.82rem; color: #555; }
  /* DB Scripts panel's own file rows reuse .paths-row-label but need real .sql filenames to fit -
     330px (fine for the Paths lightbox's short, fixed labels) wrapped them onto multiple lines
     inside that fixed box. Scoped here rather than widening the shared class, since the Paths
     lightbox's own layout isn't the complaint and shouldn't change. flex:1 1 auto lets it take
     whatever room the row has (comfortably ~3x today's width in this modal's own 90vw/1400px
     sizing) instead of a second fixed cap; white-space:nowrap is what actually stops the
     mid-label wrapping - flex-basis alone wouldn't have fixed that on its own. */
  #dbScriptsGroupsContainer .paths-row-label { flex: 1 1 auto; white-space: nowrap; min-width: 0; }
  .modal-box .paths-row input[readonly] {
    flex: 1 1 auto; width: auto; background: #f7f8fa; color: #333;
    font-family: Consolas, monospace; font-size: 0.78rem; padding: 4px 7px; margin-right: 6px;
  }
  /* Icon-only action buttons - plain CSS-drawn shapes (not a Unicode glyph) for Copy/Open folder,
     since this app has a documented history of obscure symbols silently rendering wrong in this
     IE11/Trident host (see feedback_screenshot_dpi_and_glyph_verify) - a border/background box is
     guaranteed to render identically regardless of font coverage. Open in Notepad reuses the
     pencil glyph (&#9999;) already proven safe elsewhere in this same app (the live-date edit
     icon), so only two new shapes needed inventing here. All three keep their real action as the
     button's title attribute (native tooltip) per the hover-text requirement.
  */
  .paths-row-btn {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 24px; padding: 0; margin-left: 4px;
  }
  .paths-icon-copy { display: inline-block; position: relative; width: 12px; height: 12px; }
  .paths-icon-copy .pic-back { position: absolute; top: 0; left: 0; width: 8px; height: 8px; border: 1.3px solid #fff; }
  .paths-icon-copy .pic-front { position: absolute; bottom: 0; right: 0; width: 8px; height: 8px; border: 1.3px solid #fff; background: #2f6fb3; }
  .paths-icon-copy:hover .pic-front { background: #3a80c9; }
  .paths-copy-flash .pic-front { background: #2a7a3d !important; }
  .paths-icon-folder { display: inline-block; position: relative; width: 14px; height: 11px; margin-top: 3px; }
  .paths-icon-folder .pif-tab { position: absolute; top: -3px; left: 1px; width: 6px; height: 4px; background: #fff; border-radius: 2px 2px 0 0; }
  .paths-icon-folder .pif-body { position: absolute; top: 0; left: 0; width: 14px; height: 11px; background: #fff; border-radius: 0 2px 2px 2px; }
  .paths-row-btn .paths-icon-notepad { font-size: 0.95rem; line-height: 1; }
  body.dark .paths-group-title { color: #b9c8da; border-top-color: #2c3e54; }
  body.dark .paths-row-label { color: #a9b8ca; }
  /* DB Scripts panel's Files-pane run ticks (Phase 54) - plain CSS-drawn dots, same "no untested
     glyph" reasoning as the Paths modal's icon buttons above. Sit right after the ext-icon, before
     the truncating folder/name text, so they're always visible regardless of path length - the
     specific complaint that shaped this placement. Green = Test (this app's own existing colour
     for "tested"), red = Live (this app's own existing colour for anything live/important). */
  .db-run-ticks { display: inline-flex; align-items: center; flex: 0 0 auto; margin-right: 4px; }
  .db-run-tick { width: 7px; height: 7px; border-radius: 50%; margin-right: 3px; border: 1.2px solid #bbc4cc; background: transparent; cursor: pointer; }
  .db-run-tick-lit.db-run-tick-test { background: #2a7a3d; border-color: #2a7a3d; }
  .db-run-tick-lit.db-run-tick-live { background: #c0392b; border-color: #c0392b; }
  /* A real run exists, but recorded under a DIFFERENT entry than the one currently being viewed -
     this entry's own version of the file has never itself been verified, even though the same path
     genuinely did run for real once. Amber (this app's existing "needs a second look" colour, same
     as the data-row filename-guess tier elsewhere) rather than full green/red, and deliberately
     distinct from the hollow "never run at all" state too. */
  .db-run-tick-lit-other.db-run-tick-test, .db-run-tick-lit-other.db-run-tick-live { background: #a67c00; border-color: #a67c00; }
  body.dark .db-run-tick { border-color: #3a4f68; }
  body.dark .db-run-tick-lit-other.db-run-tick-test, body.dark .db-run-tick-lit-other.db-run-tick-live { background: #d4a94f; border-color: #d4a94f; }
  /* Plain text-label buttons for the DB Scripts panel (Compare/Run Now/View before-after) - NOT
     .paths-row-btn, which is fixed-size for icon-only buttons and truncates real text labels. */
  .db-scripts-row-btn { margin-left: 6px; }
  /* Icon-only, deliberately small and green (distinct from the plain-grey .db-scripts-row-btn
     buttons either side of it) - a single-file backup fetch is a lighter-weight, more frequent
     action than Compare/Run Now, so it reads as a quick utility rather than a primary action. */
  .db-scripts-refresh-btn {
    width: 22px; height: 22px; padding: 0; margin-left: 6px; border-radius: 3px;
    background: #2a7a3d; border: 1px solid #1f5c2d; color: #fff; font-size: 0.95rem;
    line-height: 20px; cursor: pointer; vertical-align: middle;
  }
  .db-scripts-refresh-btn:disabled { background: #999; border-color: #888; cursor: default; }
  .db-scripts-refresh-btn:not(:disabled):hover { background: #358a4a; }
  .db-scripts-row-odd { background: #f6f8fa; }
  body.dark .db-scripts-row-odd { background: #16223a; }
  /* Real CSS table layout for the DB Scripts panel's file rows - not flex/grid. A column's left
     edge only lands at the same x on every sibling row automatically under table layout; flex
     can't do that once one row's content (the cross-group/cross-entry conflict indicator) is
     longer than another's, short of hand-guessing a fixed pixel width. table/table-row/table-cell
     has none of this app's own documented flex/grid quirks in IE11 - it's been solid since IE8. */
  .db-scripts-files-table { display: table; width: 100%; }
  .db-scripts-files-table > .paths-row { display: table-row; }
  /* margin doesn't apply to table-row elements, so the vertical spacing .paths-row used to get
     from its own margin:5px 0 now lives on the cells as padding instead. Four columns, per explicit
     direction: name (left-aligned, flexible), cross-entry conflict indicator (own column, right-
     aligned), backup status label (own column, right-aligned), refresh-onwards actions (own column). */
  .db-scripts-cell-name, .db-scripts-cell-conflict, .db-scripts-cell-backup, .db-scripts-cell-right {
    display: table-cell; vertical-align: middle; white-space: nowrap; padding: 4px 0;
  }
  .db-scripts-cell-conflict, .db-scripts-cell-backup { text-align: right; padding-left: 14px; }
  .db-scripts-cell-right { padding-left: 16px; }
  .db-scripts-diff-disclaimer { font-size: 0.78rem; color: #888; margin-top: 14px; border-top: 1px solid #e2e2e2; padding-top: 8px; }
  body.dark .db-scripts-diff-disclaimer { color: #7f8fa0; border-top-color: #3a4f68; }
  .db-scripts-live-warning {
    margin-top: 10px; padding: 8px 12px; background: #c0392b; color: #fff; font-weight: 700;
    border-radius: 4px; font-size: 0.92rem;
  }
  .db-scripts-confirm-input {
    width: 160px; margin-right: 6px; padding: 3px 7px; font-size: 0.82rem;
    border: 1px solid #c0392b; border-radius: 3px;
  }
  body.dark .modal-box .paths-row input[readonly] { background: #16223a; color: #cfe0f2; border-color: #3a4f68; }
  #addEntryDetails { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; }
  .field-note { font-size: 0.8rem; color: #a06a00; margin-top: 3px; }
  .details-label-row { display: flex; justify-content: space-between; align-items: baseline; }
  .details-label-row label { margin: 15px 0 6px 0; }
  .bullet-btns { display: flex; }
  .bullet-btns > * + * { margin-left: 6px; }
  .bullet-btn {
    background: #3f5871; color: #fff; border: 1px solid #56728f; border-radius: 3px;
    padding: 3px 9px; font-size: 0.78rem; cursor: pointer;
  }
  .bullet-btn:hover { background: #4c6b89; }

  /* Title + subtitle on one line, and the mode radios + Basic/Advanced toggle on one line -
     claws back the vertical space two separate rows for each used to cost. */
  .add-entry-title-row { display: flex; align-items: baseline; }
  .add-entry-title-row > * + * { margin-left: 12px; }
  .add-entry-mode-row { display: flex; align-items: baseline; flex-wrap: wrap; margin-top: 14px; }
  .add-entry-mode-row > * + * { margin-left: 16px; }

  /* --- Add Entry: git prefill (uncommitted changes / commits / recent files) --- */
  .git-prefill-radios { display: flex; flex-wrap: nowrap; margin: 0; font-size: 0.88rem; white-space: nowrap; }
  /* "label" (below) resets margin:0 for its own reasons and, being a class+type selector,
     beats a bare ".git-prefill-radios > * + *" on specificity regardless of source order -
     silently zeroing this out. "label + label" matches with equal-or-higher specificity so it
     actually wins. */
  .git-prefill-radios label { display: flex; align-items: center; margin: 0; cursor: pointer; white-space: nowrap; }
  .git-prefill-radios label + label { margin-left: 34px; }
  .git-prefill-radios label > * + * { margin-left: 5px; }
  /* The label text after each radio is a plain text node, not an element - "label > * + *"
     above only ever matches between element children (e.g. the hint span on Git commits), so it
     never puts any space between the radio itself and its text. margin-right on the radio
     directly is what actually creates that gap, regardless of what follows it. */
  .git-prefill-radios input[type="radio"] { margin-right: 6px; }
  .git-prefill-hint { margin-left: 6px; color: #999; font-size: 0.78rem; font-weight: 400; white-space: nowrap; }
  .add-entry-panes { display: flex; margin-top: 10px; }
  /* flex-basis of a plain 50% plus a margin-based gap on top always overflows the row by the
     gap amount (50% + 50% + 16px > 100%) - calc() bakes the gap into the basis instead, so the
     two items plus the gap between them sum to exactly 100% regardless of container width.
     IMPORTANT: the calc() must be set via the flex-basis LONGHAND, not the "flex" shorthand -
     IE11 silently drops the entire shorthand declaration when it contains calc() (confirmed live:
     currentStyle.flex read back as "0 1 auto", the shorthand's initial value, instead of what was
     authored), which is what was causing these panels to size by content instead of splitting
     50/50. The longhand parses calc() fine; only the shorthand's grammar chokes on it. */
  .git-prefill-panel {
    flex-grow: 1; flex-shrink: 1; flex-basis: calc(50% - 8px);
    min-width: 0; padding: 10px 12px; border: 1px solid #e2e2e2; border-radius: 3px;
    background: #f8f9fa; overflow-y: auto; overflow-x: hidden; font-size: 0.88rem; box-sizing: border-box;
    min-height: 100px;
  }
  .git-prefill-panel + .git-prefill-panel { margin-left: 16px; }
  /* addEntryBox is fixed at 95vh instead of sizing to content (like every other modal) so the
     git-prefill panels have real room to grow - same fix as markLiveBox: the Files/Details area
     below them is pulled out of normal flow and pinned to the box's bottom edge. Unlike
     markLiveBox though, this split is user-adjustable (#addEntryVResizer) - box padding-bottom
     and the block's own height are both set from script (layoutAddEntrySplit) rather than a
     fixed CSS value, so layoutAddEntryGitPanel() can measure a stable target either way. */
  #addEntryBox { position: relative; padding-bottom: 330px; overflow-x: hidden; }
  #addEntryBottomBlock { position: absolute; left: 36px; right: 36px; bottom: 30px; height: 300px; }
  /* Replaces the git-prefill panes/Files-to-Deploy/Details entirely once "Backup and Compare >>"
     is clicked in Prepare a Live Deployment mode - not just dimmed like .add-entry-locked, since
     those panes would be confusing, stale clutter behind a review list at this point. */
  #prepareLiveBackupPanel {
    position: absolute; top: 66px; left: 36px; right: 36px; bottom: 30px;
    display: flex; flex-direction: column;
  }
  /* min-width:0 needed alongside flex:0 0 auto - see .backup-compare-intro's comment for why:
     IE11 flex items won't shrink for text wrapping without it and instead spill out past the
     panel. Same reasoning applies to #prepareLiveBackupList below. */
  #prepareLiveBackupIntro { font-size: 0.85rem; color: #666; margin-bottom: 8px; flex: 0 0 auto; min-width: 0; }
  body.dark #prepareLiveBackupIntro { color: #8a97a6; }
  .live-password-row { display: flex; align-items: center; margin-bottom: 8px; flex: 0 0 auto; align-self: flex-start; }
  .live-password-row label { display: flex; align-items: center; font-size: 0.85rem; color: #666; cursor: pointer; margin: 0; white-space: nowrap; }
  body.dark .live-password-row label { color: #8a97a6; }
  .live-password-row input[type="checkbox"] { margin: 0 6px 0 0; }
  #liveSuppliedPasswordInput { margin-left: 12px; font-size: 0.85rem; padding: 2px 6px; width: 200px; }
  #prepareLiveBackupList {
    flex: 1 1 auto; min-height: 0; min-width: 0; max-height: none;
    list-style: none; margin: 0; padding: 0; overflow-y: auto;
    border: 1px solid #e2e2e2; border-radius: 3px;
  }
  body.dark #prepareLiveBackupList { border-color: #2c3e54; }
  #prepareLiveBackupStatus { font-size: 0.85rem; color: #666; margin-top: 8px; flex: 0 0 auto; }
  body.dark #prepareLiveBackupStatus { color: #8a97a6; }
  #prepareLiveBackupStatus.prepare-live-backup-status-error { color: #c0392b; font-weight: 600; }
  body.dark #prepareLiveBackupStatus.prepare-live-backup-status-error { color: #e07a6f; }
  #liveBackupAllBtn:disabled, #liveBackupCompareAllBtn:disabled { opacity: 0.5; cursor: default; }
  #prepareLiveBackupPanel .modal-actions { flex: 0 0 auto; margin-top: 10px; justify-content: flex-start; }
  #liveDeployBtn { background: #a33; border-color: #c04a4a; }
  #liveDeployBtn:disabled { background: #999; border-color: #999; opacity: 0.6; cursor: default; }
  #liveDeployBtn:not(:disabled):hover { background: #b84040; }
  #addEntryVResizer {
    position: absolute; left: 36px; right: 36px; bottom: 330px; height: 6px;
    cursor: row-resize; background: #ddd; border-radius: 3px;
  }
  #addEntryVResizer:hover { background: #bbb; }
  /* Basic view (the default) - the old pre-git-prefill "just show me the files" simple mode.
     Hides the mode radios and the two-pane git-prefill area entirely, leaving Files/Details to
     fill the space instead (see the "simple" branch in layoutAddEntrySplit()). #addEntryBasicToggle
     lives in #addEntryBasicToggleRow (.add-entry-mode-row) as a sibling of .git-prefill-radios,
     not nested inside it, so it's still visible/clickable while basic mode has the radios hidden -
     the only way back to Advanced. */
  #addEntryBox.add-entry-simple .git-prefill-radios,
  #addEntryBox.add-entry-simple .add-entry-panes,
  #addEntryBox.add-entry-simple #addEntryVResizer { display: none; }
  /* Everything locks once submission starts (see setAddEntrySubmitLocked()) except
     #addEntryActions itself - deliberately not listed here despite living inside
     .add-entry-bottom-left, since that's exactly what stays live (the success/failure buttons
     that appear once the PS1 run finishes). Targeting .details-label-row/#addEntryFilesGrid
     individually rather than the whole .add-entry-bottom-left is what keeps actions excluded -
     opacity on an ancestor isn't something a descendant can opt back out of, so actions can't be
     inside anything this rule dims. */
  #addEntryBox.add-entry-locked .add-entry-mode-row,
  #addEntryBox.add-entry-locked .add-entry-panes,
  #addEntryBox.add-entry-locked #addEntryVResizer,
  #addEntryBox.add-entry-locked .add-entry-bottom-left > .details-label-row,
  #addEntryBox.add-entry-locked #addEntryFilesGrid,
  #addEntryBox.add-entry-locked .add-entry-bottom-right {
    pointer-events: none; opacity: 0.55;
  }
  .add-entry-bottom-grid { display: flex; height: 100%; box-sizing: border-box; }
  .add-entry-bottom-left, .add-entry-bottom-right {
    /* calc() bakes the gap into the basis (see .git-prefill-panel above) - a plain 50% here
       plus the old margin-based gap always overflowed the row, which is what was pushing the
       Add Entry/Cancel buttons (in the same absolutely-positioned block) out of view and
       forcing the whole modal into horizontal scroll. Longhand flex-basis, not the shorthand -
       see .git-prefill-panel comment for why (IE11 drops the whole shorthand when it has calc()). */
    flex-grow: 1; flex-shrink: 1; flex-basis: calc(50% - 8px);
    min-width: 0; display: flex; flex-direction: column;
  }
  .add-entry-bottom-right { margin-left: 16px; }
  .add-entry-bottom-left > .details-label-row, .add-entry-bottom-right > .details-label-row { flex: 0 0 auto; }
  .git-file-section { margin-bottom: 12px; }
  .git-file-section:last-child { margin-bottom: 0; }
  .git-file-section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: #888;
    margin-bottom: 4px;
  }
  .git-file-section-head-links > * + * { margin-left: 10px; }
  .git-select-all, .git-deselect-all {
    font-weight: 400; text-transform: none; letter-spacing: normal; color: #2f6fb3; cursor: pointer; font-size: 0.78rem;
  }
  .git-select-all:hover, .git-deselect-all:hover { text-decoration: underline; }
  .git-links-pipe { font-weight: 400; text-transform: none; letter-spacing: normal; color: #ccc; font-size: 0.78rem; }
  .git-file-section-empty { color: #999; font-style: italic; font-size: 0.85rem; }
  .git-file-section-note { color: #a06a00; font-size: 0.78rem; margin-bottom: 6px; }
  .recent-files-subtitle { color: #999; font-size: 0.78rem; margin-bottom: 6px; }
  .git-file-list { list-style: none; margin: 0; padding: 0; }
  .git-file-list li {
    display: flex; align-items: center; padding: 1px 0; font-size: 0.82rem;
    white-space: nowrap; overflow: hidden;
  }
  .git-file-list li > * + * { margin-left: 5px; }
  .git-file-list li.clickable-row { cursor: pointer; }
  .git-file-list li.clickable-row:hover { background: #eef4fa; }
  /* Native disabled-checkbox rendering isn't consistently obvious in IE11, so this is spelled
     out explicitly rather than relying on default browser styling. */
  .git-file-list input[type="checkbox"]:disabled { opacity: 0.4; }
  .git-file-list .folder-part { color: #a3a3a3; }
  .git-file-list .folder-part.disabled { color: #ccc; }
  .git-file-list .folder-part.std-excluded { font-style: italic; }
  /* min-width:0 is needed for the same reason as .files-to-deploy-item elsewhere - a nowrap
     flex item won't shrink below its content's natural width by default, so a long filename
     alone could push .git-file-mtime clean off the right edge of the row instead of the name
     itself truncating to make room. */
  .git-file-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .git-file-name.disabled { color: #aaa; }
  .git-file-name.std-excluded { font-style: italic; color: #8a6d3b; }
  body.dark .git-file-name.std-excluded { color: #d4b483; }
  .git-file-mtime { color: #999; font-size: 0.76rem; flex: 0 0 auto; margin-left: auto !important; padding-left: 10px; }
  .git-file-tag {
    font-family: Segoe UI, Tahoma, Arial, sans-serif; font-size: 0.68rem; font-weight: 700;
    color: #fff; background: #a33; border-radius: 2px; padding: 0 4px; line-height: 15px; flex: 0 0 auto;
  }
  .git-commit-list-wrap { margin-bottom: 4px; }
  .git-commit-list { list-style: none; margin: 0; padding: 0; }
  .git-commit-item {
    display: flex; padding: 4px 6px; cursor: pointer; border-radius: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .git-commit-item > * + * { margin-left: 10px; }
  .git-commit-item:hover { background: #eef4fa; }
  .git-commit-item.selected { background: #cfe4f7; }
  .git-commit-hash { font-family: Consolas, monospace; color: #888; flex: 0 0 auto; }
  .git-commit-date { font-size: 0.78rem; color: #999; flex: 0 0 auto; white-space: nowrap; }
  .git-show-more { display: inline-block; margin-top: 4px; font-size: 0.8rem; color: #2f6fb3; cursor: pointer; text-decoration: underline; }
  .mark-live-link-commit-row {
    display: flex; align-items: center; padding: 3px 4px; cursor: pointer; border-radius: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .mark-live-link-commit-row:hover { background: #eef4fa; }
  .mark-live-link-commit-row input { margin-right: 4px; cursor: pointer; }
  .mark-live-link-note { font-size: 0.8rem; color: #888; margin-top: 8px; }
  #markLiveLinkSelectedSummary { font-size: 0.85rem; color: #556; margin-top: 8px; font-weight: 600; }
  #markLiveSaveCommitLinkBtn { margin-top: 8px; }
  .recent-files-fallback-separator { border: none; border-top: 1px dotted #ccc; margin: 8px 0 6px 0; }
  body.dark .recent-files-fallback-separator { border-top-color: #3a4f68; }
  .git-commit-prefix {
    font-size: 0.85rem; color: #555; background: #eef1f4; border: 1px solid #dde3e8; border-radius: 3px;
    padding: 4px 8px; margin: 8px 0 0 0; font-family: Consolas, monospace;
  }

  /* "Recently deployed" pane: click-to-toggle pills grouped per deploy batch, matching how
     files are shown in the main list. A batch that contributed nothing new (every file it
     touched was already shown by a more recent batch) is skipped entirely, rather than
     leaving an empty row + separator behind. */
  .deployed-pill-row { display: flex; flex-wrap: wrap; align-items: center; margin: 6px 0; }
  .deployed-pill-row > * { margin: 2px 4px 2px 0; }
  /* This is a sibling of .deployed-pill-row (appended directly to the panel between rows),
     not nested inside it, so it needs its own class rather than a ".deployed-pill-row hr"
     descendant selector - which never matched, hence the leftover default <hr> spacing. */
  hr.deployed-separator { border: none; border-top: 1px solid #e2e2e2; margin: 3px 0; }
  .deployed-add-all {
    margin-left: auto !important; cursor: pointer; color: #2f6fb3; font-size: 0.78rem; text-decoration: underline;
    flex: 0 0 auto;
  }
  .deployed-add-all:hover { color: #1d4d7d; }
  .deployed-pill {
    display: inline-block; padding: 2px 8px; border-radius: 10px; color: #fff; font-size: 0.78rem;
    cursor: pointer; white-space: nowrap;
  }
  .deployed-pill.dimmed { opacity: 0.35; }
  .deployed-pill.blocked { opacity: 0.35; cursor: not-allowed; }
  .deployed-pill.std-excluded { opacity: 0.6; border: 1px dashed rgba(255,255,255,0.6); }

  /* "Files to Deploy" quadrant: the real data lives in the hidden #addEntryFiles textarea
     (unchanged from before) - this is a read-only-looking 2-column view built from it, plus
     a small text input for adding paths by hand (typing/Enter still works, same as before). */
  .files-to-deploy-grid {
    /* height comes from script (layoutAddEntrySplit) so dragging #addEntryVResizer actually
       grows this, not just a fixed CSS cap.
       Column-major fill (left column filled top-to-bottom before the next starts) is built by
       JS into real .files-to-deploy-column divs (see renderFilesToDeployGrid()), not CSS multi-
       column - IE11/Trident doesn't respect a fixed column-count once content exceeds the
       container's bounded height, it just keeps adding MORE columns sideways instead of scrolling
       the last one, which reintroduced the exact horizontal-overflow bug this was meant to fix
       (confirmed live: 31 items produced 8 columns instead of 3). This is just a flex row of
       column divs instead, each sized via the flex-basis LONGHAND with calc() (see
       .git-prefill-panel comment for why not the shorthand) - already proven reliable here. */
    display: flex; align-items: flex-start; overflow-y: auto;
    border: 1px solid #e2e2e2; border-radius: 3px; padding: 6px; background: #f8f9fa; box-sizing: border-box;
  }
  .files-to-deploy-column {
    /* 3 columns + 2 12px gaps: each column's fair share of the gap is 24px/3 = 8px. */
    flex-grow: 1; flex-shrink: 1; flex-basis: calc(33.333% - 8px); min-width: 0;
  }
  .files-to-deploy-column + .files-to-deploy-column { margin-left: 12px; }
  .files-to-deploy-item {
    display: flex; align-items: center; margin: 0 0 6px 0; padding: 3px 6px;
    background: #fff; border: 1px solid #e2e2e2; border-radius: 3px; font-size: 0.82rem;
    overflow: hidden; white-space: nowrap; box-sizing: border-box;
  }
  .files-to-deploy-item > * + * { margin-left: 5px; }
  .files-to-deploy-name { overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 0; }
  .files-to-deploy-name.missing { color: #c1440e; font-weight: 600; }
  .files-to-deploy-name.delete { color: #a33; }
  .files-to-deploy-name.reverted { color: #c0392b; }
  .files-to-deploy-name.std-excluded { font-style: italic; color: #8a6d3b; }
  body.dark .files-to-deploy-name.std-excluded { color: #d4b483; }
  .files-to-deploy-excl-tag { background: #b8860b; }
  .ext-icon.missing { background: #c0392b; }
  .adhoc-compare-menu {
    position: fixed; z-index: 9999; background: #fff; border: 1px solid #ccc; border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2); padding: 4px 0; font-size: 0.85rem;
  }
  .adhoc-compare-menu-item { padding: 6px 14px; cursor: pointer; white-space: nowrap; }
  .adhoc-compare-menu-item:hover { background: #eef3fa; }
  .adhoc-compare-menu-item-disabled { color: #999; cursor: default; }
  .adhoc-compare-menu-item-disabled:hover { background: inherit; }
  body.dark .adhoc-compare-menu { background: #1e2f48; border-color: #3a4f68; }
  body.dark .db-conflict-menu-title { border-bottom-color: #3a4f68; }
  body.dark .adhoc-compare-menu-item:hover { background: #2c3e54; }
  body.dark .adhoc-compare-menu-item-disabled { color: #778; }
  body.dark .adhoc-compare-menu-item-disabled:hover { background: inherit; }
  .adhoc-compare-status {
    position: fixed; right: 16px; bottom: 16px; z-index: 9998; background: #fff; border: 1px solid #ccc;
    border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.2); padding: 10px 14px; font-size: 0.85rem;
    max-width: 360px;
  }
  .adhoc-compare-status.adhoc-compare-status-error { border-color: #e07a6f; color: #a8362a; }
  .adhoc-compare-status.adhoc-compare-status-has-password { padding-right: 30px; }
  .adhoc-compare-status-password-row { margin-top: 8px; display: flex; gap: 6px; }
  .adhoc-compare-cancel-btn {
    display: block; margin-top: 8px; padding: 4px 12px; font-size: 0.78rem; color: #fff;
    background: #a33; border: 1px solid #c04a4a; border-radius: 3px; cursor: pointer;
  }
  .adhoc-compare-cancel-btn:hover { background: #b84040; }
  .adhoc-compare-status-password-row input { flex: 1 1 auto; min-width: 0; }
  .adhoc-compare-status-close {
    position: absolute; top: 6px; right: 8px; cursor: pointer; color: #888; font-size: 1rem;
    line-height: 1; font-weight: 700;
  }
  .adhoc-compare-status-close:hover { color: #c0392b; }
  body.dark .adhoc-compare-status { background: #1e2f48; border-color: #3a4f68; color: #e9edf2; }
  body.dark .adhoc-compare-status.adhoc-compare-status-error { border-color: #e07a6f; color: #e07a6f; }
  body.dark .adhoc-compare-status-close { color: #8a97a6; }
  body.dark .adhoc-compare-status-close:hover { color: #e57373; }
  /* Bottom-of-screen, non-blocking - replaces the old blocking "Heads up"/"could not find
     commit(s)" alerts on the Prepare-Live modal's Commits tab. z-index above .modal-overlay's
     1000 so it stays visible while that modal is open. */
  .prepare-live-discrepancy-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 2000; box-sizing: border-box;
    background: #fff6cf; border-top: 2px solid #d9b93c; color: #4a3b0a;
    padding: 8px 40px 8px 14px; font-size: 0.85rem;
  }
  .prepare-live-discrepancy-line {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .prepare-live-discrepancy-note { color: #8a7534; font-style: italic; margin-top: 2px; }
  .prepare-live-discrepancy-close {
    position: absolute; top: 6px; right: 14px; cursor: pointer; color: #8a7534; font-size: 1rem;
    line-height: 1; font-weight: 700;
  }
  .prepare-live-discrepancy-close:hover { color: #4a3b0a; }
  body.dark .prepare-live-discrepancy-bar { background: #4a4020; border-top-color: #d4a94f; color: #f0e4b8; }
  body.dark .prepare-live-discrepancy-note { color: #d4a94f; }
  body.dark .prepare-live-discrepancy-close { color: #d4a94f; }
  body.dark .prepare-live-discrepancy-close:hover { color: #f0e4b8; }
  .files-to-deploy-refresh { cursor: pointer; color: #888; flex: 0 0 auto; font-weight: 700; }
  .files-to-deploy-refresh:hover { color: #2f6fb3; }
  .files-to-deploy-x { cursor: pointer; color: #999; flex: 0 0 auto; margin-left: auto !important; font-weight: 700; }
  .files-to-deploy-x:hover { color: #c0392b; }
  .files-to-deploy-manual-input {
    width: 100%; box-sizing: border-box; margin-top: 6px; padding: 5px 8px; font-size: 0.85rem;
    border: 1px solid #bbc4cc; border-radius: 3px;
  }
  /* Now sits inline in .details-label-row (between the label and Clear list) - an ID selector
     is used here since ".modal-box input:not(...)" (3-class-equivalent specificity) would
     otherwise win over a same-or-lower-specificity class override, per the radio-spacing bug
     fixed earlier in this file. */
  #addEntryFilesManualInput {
    width: auto; flex: 1 1 auto; min-width: 0; margin: 0 12px; padding: 4px 8px; font-size: 0.82rem;
    box-sizing: border-box; border: 1px solid #bbc4cc; border-radius: 3px;
  }

  .modal-actions button.add-entry-cancel-btn, .modal-actions button.add-entry-confirm-btn {
    flex: 0 0 auto; padding: 4px 14px; font-size: 0.8rem; color: #fff;
  }
  .modal-actions button.add-entry-cancel-btn { background: #a33; border-color: #c04a4a; }
  .modal-actions button.add-entry-cancel-btn:hover { background: #b84040; }
  .modal-actions button.add-entry-confirm-btn { background: #2f6fb3; border-color: #3f7fc4; }
  .modal-actions button.add-entry-confirm-btn:hover { background: #3a80c9; }
  .modal-actions button.add-entry-confirm-btn:disabled {
    background: #9aa5ae; border-color: #aab4bc; color: #e6e9ec; cursor: not-allowed;
  }
  .modal-actions button.add-entry-success-btn {
    flex: 0 0 auto; padding: 8px 24px; font-size: 0.9rem; background: #2e8b3d; border-color: #3fa652; color: #fff;
  }
  .modal-actions button.add-entry-success-btn:hover { background: #379e47; }
  .modal-actions button.add-entry-close-later-btn {
    flex: 0 0 auto; padding: 8px 18px; font-size: 0.85rem; background: #888; border-color: #999; color: #fff;
  }
  .modal-actions button.add-entry-close-later-btn:hover { background: #767676; }

  .modal-actions.overwrite-actions { flex-direction: column; }
  .modal-actions.overwrite-actions > * + * { margin-left: 0; margin-top: 10px; }
  .modal-actions.overwrite-actions button { flex: 1 1 auto; padding: 10px 14px; color: #fff; }
  .overwrite-copy-btn { background: #2e8b3d; border-color: #3fa652; }
  .overwrite-copy-btn:hover { background: #379e47; }
  .overwrite-replace-btn { background: #a33; border-color: #c04a4a; }
  .overwrite-replace-btn:hover { background: #b84040; }
  .overwrite-cancel-btn { background: #888; border-color: #999; }
  .overwrite-cancel-btn:hover { background: #767676; }

  #markLiveSummary, #addEntrySummary, #editEntrySummary { font-size: 0.85rem; color: #666; margin-bottom: 4px; }
  .add-entry-subtitle { font-size: 0.82rem; color: #888; white-space: nowrap; }
  #markLiveSuggestionsSection { margin-top: 15px; }
  #markLiveSuggestionsSection label { display: block; margin-bottom: 6px; }
  .deploy-suggestion-item { cursor: pointer; }
  .deploy-suggestion-item:hover { background: #eef4fa; }
  #markLiveShowAllToggle {
    display: none; font-size: 0.8rem; color: #2f6fb3; cursor: pointer; margin-top: 4px;
    text-decoration: underline;
  }
  #markLiveSummary { line-height: 1.5; }
  /* Fixed px width, not flex:1 1 auto - same reasoning/lesson as .test-deploy-backup-col
     (see that block's own comment): IE11 doesn't reliably shrink a flex item that's also a flex
     container down to its available space, even with min-width:0 everywhere. 608px is this
     column's own natural rendered width today (680px box minus 2*36px padding) - fixing it here
     keeps the existing left/right layout pixel-identical whether or not the backup panel is
     open, since the outer row is new but this column's own size never changes. */
  .mark-live-outer-row { display: flex; min-width: 0; }
  .mark-live-columns { display: flex; flex-direction: column; margin-top: 10px; flex: 0 0 608px; box-sizing: border-box; min-width: 0; }
  .mark-live-columns > * + * { margin-top: 20px; }
  .mark-live-left { min-width: 0; }
  .mark-live-right { min-width: 0; }
  .mark-live-right-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .mark-live-right-head label { margin: 0; }
  .mark-live-right-head-actions { display: flex; align-items: center; }
  .mark-live-right-head-actions > * + * { margin-left: 8px; }
  #markLiveCompareBtn, .mark-live-view-backup-btn { font-size: 0.75rem; padding: 3px 10px; }
  .mark-live-compare-result {
    border: 1px solid #e2e2e2; border-radius: 3px; padding: 8px 12px; margin-bottom: 8px;
    font-size: 0.85rem; box-sizing: border-box;
  }
  .mark-live-compare-result h4 {
    font-size: 0.8rem; margin: 8px 0 4px 0; color: #888; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .mark-live-compare-result h4:first-child { margin-top: 0; }
  .mark-live-compare-warn-heading { color: #c0392b; }
  body.dark .mark-live-compare-warn-heading { color: #e0685a; }
  .mark-live-compare-allgood { color: #2a7a3d; font-weight: 600; }
  body.dark .mark-live-compare-allgood { color: #4caf6a; }
  .mark-live-compare-tick { margin-right: 6px; }
  body.dark .mark-live-compare-result { border-color: #2c3e54; }
  .mark-live-right label { display: block; margin: 0 0 6px 0; font-size: 0.9rem; color: #555; }
  .mark-live-datetime-row { display: flex; align-items: flex-end; margin: 15px 0; }
  .mark-live-datetime-row > * + * { margin-left: 10px; }
  .mark-live-field { flex: 0 0 170px; }
  .mark-live-field-time { flex: 0 0 119px; }
  .mark-live-field label { margin: 0 0 6px 0; }
  .mark-live-time-wrap { position: relative; }
  .mark-live-time-wrap input { padding-right: 26px; }
  /* IE shows its own native clear-x on a focused text input, which sits in the same spot
     as our custom clear icon below but blanks the field instead of resetting it to 00:00 -
     hidden so only our icon (with the correct behaviour) is there. */
  .mark-live-time-wrap input::-ms-clear { display: none; }
  .mark-live-time-clear {
    position: absolute; right: 8px; top: 50%; margin-top: -8px; width: 16px; height: 16px;
    line-height: 16px; text-align: center; font-size: 0.75rem; color: #888; cursor: pointer;
  }
  .mark-live-time-clear:hover { color: #c0392b; }
  #markLiveSuggestionsList.deploy-file-list { max-height: 210px; }
  #linkCommitList.deploy-file-list { max-height: 340px; margin-bottom: 12px; }
  #manageProjectsList.deploy-file-list { max-height: 360px; margin-top: 10px; }
  .manage-project-row { display: flex; align-items: center; justify-content: space-between; white-space: normal; }
  .manage-project-info { min-width: 0; overflow: hidden; margin-right: 10px; }
  .manage-project-name { font-weight: 700; }
  .manage-project-path {
    font-size: 0.78rem; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .manage-project-actions { flex: 0 0 auto; white-space: nowrap; }
  .manage-project-actions button { font-size: 0.78rem; padding: 3px 7px; margin-left: 6px; }
  .manage-project-notest { display: block; font-size: 0.78rem; color: #888; margin-top: 2px; }
  .ftp-no-test-row { display: block; font-weight: normal; margin: 0 0 14px; }
  .mark-live-file-details {
    /* height is set from script (layoutMarkLiveDetails) to fill whatever space is left in the
       modal below the date/time + suggestions section and above the action buttons - a fixed
       CSS height can't do this since it depends on the suggestions list's actual rendered size,
       and IE's flexbox doesn't reliably give column-direction items a definite height to grow
       into (same class of bug as the main list/details/files pane layout). */
    overflow-y: auto; border: 1px solid #e2e2e2; border-radius: 3px;
    padding: 10px 12px; box-sizing: border-box; font-size: 0.85rem; min-height: 80px;
  }
  .mark-live-details-placeholder { color: #888; font-style: italic; }
  .mark-live-details-meta { font-size: 0.8rem; color: #888; margin-bottom: 8px; }
  .mark-live-retrospective-note {
    background: #fff6cf; border: 1px solid #d9b93c; color: #6b5a12; border-radius: 3px;
    padding: 6px 10px; font-style: normal;
  }
  .mark-live-file-details h4 {
    font-size: 0.8rem; margin: 10px 0 4px 0; color: #888; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .mark-live-file-details h4:first-child { margin-top: 0; }
  .mark-live-parsed-files { list-style: none; margin: 0 0 6px 0; padding: 0; }
  .mark-live-parsed-files li { padding: 2px 0; font-size: 0.85rem; font-family: Consolas, monospace; }
  .mark-live-parsed-files.muted li { color: #999; }
  /* Fixed px width for the same IE11 reason as .mark-live-columns above (and .test-deploy-backup-
     col before it) - 701px = 720px available (1400px wide box minus 36*2 padding minus
     .mark-live-columns' own 608px) minus this panel's own 18px padding-left + 1px border-left,
     compensating for IE11 adding that padding/border back on top of a declared flex-basis width
     even with box-sizing:border-box set (measured and confirmed live before finalizing this
     number - see Phase 4's matching backup-col comment for how that was diagnosed). */
  .mark-live-backup-panel {
    flex-direction: column; min-width: 0; box-sizing: border-box;
    border-left: 1px solid #e2e2e2; padding-left: 18px; margin-top: 10px;
    flex: 0 0 701px; width: 701px;
  }
  body.dark .mark-live-backup-panel { border-left-color: #2c3e54; }
  #markLiveBackupIntro { font-size: 0.82rem; color: #666; margin-bottom: 8px; flex: 0 0 auto; min-width: 0; }
  body.dark #markLiveBackupIntro { color: #8a97a6; }
  #markLiveBackupStatus { font-size: 0.8rem; color: #666; margin: 8px 0; flex: 0 0 auto; min-width: 0; }
  body.dark #markLiveBackupStatus { color: #8a97a6; }
  #markLiveBackupStatus.mark-live-backup-status-error { color: #c0392b; font-weight: 600; }
  body.dark #markLiveBackupStatus.mark-live-backup-status-error { color: #e07a6f; }
  /* max-height (not flex-grow + JS-computed height) deliberately, to avoid adding another
     IE11 flex-height layout dance - same simpler approach #markLiveSuggestionsList already
     uses in this same modal. */
  #markLiveBackupList { flex: 0 0 auto; min-width: 0; max-height: 420px; overflow-y: auto; }
  .mark-live-backup-status-actions { flex: 0 0 auto; display: flex; align-items: center; font-size: 0.75rem; }
  .mark-live-backup-password-row { display: flex; align-items: center; margin: 8px 0; flex: 0 0 auto; }
  .mark-live-backup-password-row input[type="password"] { font-size: 0.8rem; padding: 2px 6px; width: 160px; margin-right: 8px; }
  .mark-live-backup-password-close {
    margin-left: 8px; cursor: pointer; color: #888; font-size: 1rem; font-weight: 700; line-height: 1;
  }
  .mark-live-backup-password-close:hover { color: #c0392b; }
  body.dark .mark-live-backup-password-close { color: #8a97a6; }
  body.dark .mark-live-backup-password-close:hover { color: #e57373; }
  .pane-header-left { display: flex; align-items: baseline; min-width: 0; }
  .pane-header-left > * + * { margin-left: 10px; }
  .pane-header-left h2.section { padding-right: 8px; }
  .details-live-desc {
    font-size: 0.85rem; color: #888; font-weight: 500; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .meta-live-edit { cursor: pointer; margin-left: 6px; font-size: 0.85rem; }
  .modal-actions { margin-top: 21px; display: flex; }
  .modal-actions > * + * { margin-left: 12px; }
  .modal-actions button { flex: 1; padding: 9px 12px; cursor: pointer; font-size: 0.88rem; }
  /* Once the Test Deploy modal is down to just a Close button, it doesn't need to (and
     shouldn't) stretch full-width like the Deploy/Cancel pair did. */
  .modal-actions.single-action { justify-content: center; }
  .modal-actions.single-action button { flex: 0 0 auto; }
  /* ".modal-actions button" (below) would otherwise win on specificity over a bare
     .close-btn-done class, so this is qualified the same way. */
  .modal-actions button.close-btn-done {
    padding: 5px 20px; font-size: 0.85rem; background: #2f6fb3; color: #fff; border: 1px solid #3f7fc4;
  }
  .modal-actions button.close-btn-done:hover { background: #3a80c9; }
  /* markLiveBox is fixed at 95vh (see its inline style) instead of sizing to content like
     every other modal - without this, the actions row just sits in normal flow right after
     the (much shorter) content, leaving a large dead gap below it, and layoutMarkLiveDetails()
     ends up measuring that small content-to-actions gap instead of the real available space.
     Pinning the actions row to the box's bottom edge fixes both: it's actually at the bottom,
     and the details pane correctly gets everything above it. */
  #markLiveBox { position: relative; padding-bottom: 80px; }
  #markLiveBox .modal-actions { position: absolute; left: 36px; right: 36px; bottom: 30px; margin: 0; }
  #addEntryLog { margin-top: 10px; }

  /* flex:0 0 auto (not the default shrink:1) so this row never gets squeezed narrower than its
     own content when .pane-header-left needs the room instead - that side already has min-width:0
     specifically so IT absorbs the squeeze. white-space:nowrap on every direct child stops a
     button's own label wrapping onto a second line under the same pressure; wider padding makes
     each button easier to read/click instead of sitting at its tightest natural width. */
  #detailsActions { display: flex; align-items: center; flex: 0 0 auto; }
  #detailsActions > * + * { margin-left: 8px; }
  #detailsActions > * { flex: 0 0 auto; white-space: nowrap; }
  #detailsActions button.test-deploy-btn { padding: 3px 16px; }
  .group-status-text { font-size: 0.85rem; color: #666; }
  .group-info-icon { font-size: 0.9rem; color: #888; cursor: help; }
  .group-btn-keep { background: #2a7a3d; border-color: #368f4c; }
  .group-btn-keep:hover { background: #32924a; }
  /* Focused by script the moment the merge-into-existing-group confirmation opens (see
     offerGroupMergeConflict()) - a visible ring here is what makes it obvious Enter is about to
     hit this button specifically, not a guess at what the default action even is. */
  #groupMergeConfirmBtn:focus { outline: none; box-shadow: 0 0 0 3px rgba(42, 122, 61, 0.5); }
  .group-btn-undo { background: #a33; border-color: #c04a4a; }
  .group-btn-undo:hover { background: #b84040; }
  body.dark .group-status-text { color: #b9c8da; }
  body.dark .group-info-icon { color: #8a97a6; }

  .mark-live-fitness-row { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
  .mark-live-fitness-status { font-size: 0.85rem; color: #666; }
  .mark-live-fitness-status.fitness-status-fit { color: #2a7a3d; font-weight: 600; }
  .mark-live-fitness-status.fitness-status-notfit { color: #a67c00; font-weight: 600; }
  body.dark .mark-live-fitness-status { color: #b9c8da; }
  body.dark .mark-live-fitness-status.fitness-status-fit { color: #4fbf6e; }
  body.dark .mark-live-fitness-status.fitness-status-notfit { color: #d4a94f; }
  .fitness-btn-fit { background: #2a7a3d; border-color: #368f4c; }
  .fitness-btn-fit:hover { background: #32924a; }
  .fitness-btn-notfit { background: #a67c00; border-color: #c99a1f; }
  .fitness-btn-notfit:hover { background: #bf8f10; }

  /* ---- Dark mode: flip dark-grey/black text to light, keep badge pill colours as-is ---- */
  body.dark { background: #16223a; color: #e9edf2; }
  body.dark #filterBar { background: #1e2f48; border-bottom-color: #2c3e54; }
  body.dark #filterBar label { color: #b9c8da; }
  body.dark .group-option-label { color: #b9c8da; }
  body.dark .pane-view-toggle-label { color: #b9c8da; }
  body.dark #filterBar > input { background: #16223a; color: #e9edf2; border-color: #3a4f68; }
  body.dark #filterBar .filter-mode-btn { background: #3f5871; }
  body.dark .live-filter-btn { background: #16223a; color: #cfe0f2; border-color: #3a4f68; }
  body.dark .live-filter-btn:hover { background: #22344c; }
  body.dark .live-filter-btn.active { background: #3f5871; color: #fff; border-color: #56728f; }
  body.dark .pane-view-toggle-btn { background: #16223a; color: #cfe0f2; border-color: #3a4f68; }
  body.dark .pane-view-toggle-btn:hover { background: #22344c; }
  body.dark .pane-view-toggle-btn.active { background: #3f5871; color: #fff; border-color: #56728f; }
  body.dark .pill-filter-box { background: #16223a; border-color: #3a4f68; }
  body.dark .filter-pill { background: #2c3e54; color: #cfe0f2; }
  body.dark .filter-pill-x { color: #8a97a6; }
  body.dark .filter-pill-x:hover { color: #e57373; }
  body.dark .pill-filter-input { color: #e9edf2; }
  body.dark .pill-filter-box.filter-has-content { background: #4a4020; border-color: #d4a94f; }
  body.dark #detailFilterInput.filter-has-content { background: #4a4020; border-color: #d4a94f; }
  body.dark #resultCount { color: #b9c8da; }
  body.dark #listPane, body.dark #detailsPane, body.dark #filesPane {
    background: #1b2a42; border-color: #2c3e54;
  }
  body.dark #listPane { border-right-color: #2c3e54; }
  body.dark #resizer, body.dark #vresizer, body.dark #addEntryVResizer { background: #2c3e54; }
  body.dark #resizer:hover, body.dark #vresizer:hover { background: #3d5470; }
  body.dark .date-header {
    background: #0f1a2c;
    color: #e9edf2;
    border-bottom-color: #4fa8e0;
    border-bottom-width: 3px;
  }
  body.dark .date-header-stats { color: #a9bccf; }
  body.dark .row { border-bottom-color: #26374c; }
  body.dark .hidden-items-placeholder { color: #8a97a6; background: #16223a; border-bottom-color: #26374c; }
  body.dark .hidden-items-placeholder.compact { background: #16223a; border-top-color: #3a4f68; border-bottom-color: #3a4f68; }
  body.dark .row:hover { background: #22344c; }
  body.dark .row.selected { background: #2f4a6b; }
  /* Yellow (not red) in dark mode specifically - matches the established "muted amber" tone
     already used for warning/note text elsewhere (.field-note, .git-file-section-note etc.). */
  body.dark .row.entry-grouped .row-id, body.dark .row.entry-grouped .row-summary { color: #d4a94f; }
  body.dark .row.git-batch-sibling .row-id, body.dark .row.git-batch-sibling .row-summary { color: #e0a83e; }
  body.dark .row-id { color: #9fb0c2; }
  body.dark .row-summary { color: #ccd5de; }
  body.dark h2.section { color: #9fb0c2; border-bottom-color: #2c3e54; }
  body.dark .pane-header-row { border-bottom-color: #2c3e54; }
  body.dark .pane-count { color: #6d7a89; }
  body.dark #deploySummary { color: #b9c8da; }
  body.dark .deploy-progress-wrap { background: #22344c; }
  body.dark .deploy-log { background: #16223a; border-color: #2c3e54; color: #ccd5de; }
  body.dark .deploy-file-list { border-color: #2c3e54; }
  body.dark .deploy-file-list li { border-bottom-color: #26374c; background: #1e2f48; }
  body.dark .manage-project-path { color: #7f8fa0; }
  body.dark .manage-project-notest { color: #7f8fa0; }
  body.dark .deploy-suggestion-item.selected { background: #2f4a6b; }
  body.dark .deploy-status-pending { color: #8a97a6; }
  body.dark .deploy-status-not-on-server { color: #7f8fa0; }
  body.dark .deploy-status-excluded { color: #d4b483; }
  body.dark .backup-compare-intro { color: #8a97a6; }
  body.dark .backup-status-actions label { color: #8a97a6; }
  body.dark #backupCompareStatus { color: #8a97a6; }
  body.dark #detailsMeta { color: #b9c5d1; }
  body.dark #detailsMeta .meta-live-prefix { color: #b9c5d1; }
  body.dark #detailsMeta .meta-live-value { color: #e0685a; }
  body.dark .group-summary-input { background: #16223a; color: #e9edf2; border-color: #3a4f68; }
  body.dark #detailsBody, body.dark #detailsBody li { color: #e5e9ee; }
  body.dark .multi-entry { border-bottom-color: #2c3e54; }
  body.dark .multi-entry-date { color: #b9c8da; }
  body.dark #filesBody li { border-bottom-color: #2c3e54; color: #dfe4ea; }
  body.dark #filesBody li:hover { background: #22344c; }
  body.dark #filesBody .folder-part { color: #7f8fa0; }
  body.dark #filesBody li.std-excluded .files-pane-name { color: #d4b483; }
  body.dark #filesBody li .files-pane-cherry-note { color: #9fce62; }
  body.dark #filesBody li.reverted .files-pane-name, body.dark #filesBody li.reverted .folder-part { color: #e0685a; }
  body.dark #filesBody li .files-pane-reverted-note { color: #e0685a; }
  body.dark #filesBody li .files-pane-superseded-flag { color: #e0685a; }
  body.dark #filesBody li .files-pane-conflict-later { color: #4fa8e0; }
  body.dark #filesBody li .files-pane-conflict-earlier { color: #e0685a; }
  body.dark .conflict-more-menu-later { color: #4fa8e0; }
  body.dark .conflict-more-menu-earlier { color: #e0685a; }
  body.dark #filesBody li .files-pane-conflict-later.files-pane-conflict-weak, body.dark #filesBody li .files-pane-conflict-earlier.files-pane-conflict-weak { color: #d4a94f; }
  body.dark #filesBody li .files-pane-conflict-later.conflict-exception-grey,
  body.dark #filesBody li .files-pane-conflict-earlier.conflict-exception-grey { color: #7f8fa0; }
  body.dark #filesBody .file-count { color: #b9c8da; }
  body.dark #empty { color: #8a97a6; }
  body.dark .modal-box { background: #1b2a42; color: #e9edf2; }
  body.dark .modal-box label { color: #b9c8da; }
  body.dark .modal-box input:not([type="checkbox"]):not([type="radio"]), body.dark .modal-box textarea { background: #16223a; color: #e9edf2; border-color: #3a4f68; }
  body.dark .modal-box textarea[readonly] { background: #223046; color: #7f8fa0; }
  body.dark .exclusions-pane { background: #16223a; border-color: #3a4f68; }
  body.dark .exclusions-std-item { border-bottom-color: #2c3e54; }
  body.dark .exclusions-std-reason { color: #7f8fa0; }
  /* Same red in both themes - matches how every other red/cancel-style element in this file
     (.add-entry-cancel-btn etc.) has no separate dark-mode variant either. */
  body.dark .modal-close-x:hover { background: #c04a4a; }
  body.dark .field-note { color: #d4a94f; }
  body.dark .git-prefill-panel { background: #16223a; border-color: #3a4f68; }
  body.dark .git-prefill-hint { color: #6d7a89; }
  body.dark .git-file-section-head { color: #8a97a6; }
  body.dark .git-select-all, body.dark .git-deselect-all { color: #6fa8e0; }
  body.dark .git-links-pipe { color: #4a5a70; }
  body.dark .db-conflict-nums { color: #b9c8da; }
  body.dark .db-conflict-nums .conflict-exception-struck { color: #6d7a89; }
  body.dark .db-conflict-menu-head.conflict-exception-struck { color: #6d7a89; }
  body.dark .db-conflict-path { color: #7f8fa0; }
  body.dark .git-file-section-empty { color: #6d7a89; }
  body.dark .git-file-section-note { color: #d4a94f; }
  body.dark .recent-files-subtitle { color: #7f8fa0; }
  body.dark .git-file-list li { color: #dfe4ea; }
  body.dark .git-file-list .folder-part { color: #7f8fa0; }
  body.dark .git-file-list .folder-part.disabled { color: #4d5a6a; }
  body.dark .git-file-name.disabled { color: #6d7a89; }
  body.dark .git-file-mtime { color: #7f8fa0; }
  body.dark .git-file-list li.clickable-row:hover { background: #22344c; }
  body.dark .git-commit-item:hover { background: #22344c; }
  body.dark .git-commit-item.selected { background: #2f4a6b; }
  body.dark .git-commit-hash { color: #8a97a6; }
  body.dark .git-commit-date { color: #7f8fa0; }
  body.dark .git-show-more { color: #6fa8e0; }
  body.dark .mark-live-link-commit-row:hover { background: #22344c; }
  body.dark .mark-live-link-note { color: #8a97a6; }
  body.dark #markLiveLinkSelectedSummary { color: #b9c8da; }
  body.dark .git-commit-prefix { background: #16223a; border-color: #3a4f68; color: #b9c8da; }
  body.dark hr.deployed-separator { border-top-color: #2c3e54; }
  body.dark .deployed-add-all { color: #6fa8e0; }
  body.dark .deployed-add-all:hover { color: #a9cdf0; }
  body.dark .files-to-deploy-grid { background: #16223a; border-color: #3a4f68; }
  body.dark .files-to-deploy-item { background: #1e2f48; border-color: #2c3e54; color: #dfe4ea; }
  body.dark .files-to-deploy-x { color: #7f8fa0; }
  body.dark .files-to-deploy-x:hover { color: #e57373; }
  body.dark .files-to-deploy-refresh { color: #8a97a6; }
  body.dark .files-to-deploy-refresh:hover { color: #6fa8e0; }
  body.dark .files-to-deploy-name.missing { color: #e08b4f; }
  body.dark .files-to-deploy-name.delete { color: #e0685a; }
  body.dark .files-to-deploy-name.reverted { color: #e0685a; }
  body.dark .files-to-deploy-manual-input { background: #16223a; color: #e9edf2; border-color: #3a4f68; }
  body.dark #markLiveSummary, body.dark #addEntrySummary, body.dark #editEntrySummary { color: #a9bccf; }
  body.dark .add-entry-subtitle { color: #7f8fa0; }
  body.dark .mark-live-right label { color: #b9c8da; }
  body.dark .mark-live-time-clear { color: #7f8fa0; }
  body.dark .mark-live-time-clear:hover { color: #e57373; }
  body.dark .mark-live-file-details { border-color: #2c3e54; background: #16223a; color: #dfe4ea; }
  body.dark .mark-live-details-placeholder { color: #8a97a6; }
  body.dark .mark-live-details-meta { color: #8a97a6; }
  body.dark .mark-live-retrospective-note { background: #4a4020; border-color: #d4a94f; color: #f0e4b8; }
  body.dark .mark-live-file-details h4 { color: #8a97a6; }
  body.dark .mark-live-parsed-files.muted li { color: #6d7a89; }
  body.dark .deploy-suggestion-item:hover { background: #22344c; }
  body.dark .details-live-desc { color: #8a97a6; }
</style>
</head>
<body>
<script>
// Applied here, before anything else in <body> parses/paints, specifically to avoid a flash of
// the default light background before window.onload's setDarkMode() gets around to it - by then
// the page has already painted once, which on a dark-themed system was a blinding white flash
// every launch. Duplicated (rather than calling detectSystemDark()/setDarkMode()) since those are
// defined in a <script> block further down the page that hasn't run yet at this point.
try {
  var _preShell = new ActiveXObject("WScript.Shell");
  if (_preShell.RegRead("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize\\AppsUseLightTheme") === 0) {
    document.body.className = "dark";
    // body.dark's CSS background covers the body element itself, but <html> has its own light
    // background (the "html, body" rule) with no dark override - set inline so there's nothing
    // left that can flash light, even for a single frame before body is fully laid out.
    document.documentElement.style.background = "#16223a";
  }
} catch (e) { /* best effort - worst case is one light flash on a dark system */ }
</script>

<div id="header">
  <div class="title">RedeployFTP</div>
  <label for="projectSelect">Project:</label>
  <select id="projectSelect" class="project-select" onchange="onProjectSelectChange()"></select>
  <button onclick="openManageProjectsModal()" title="Manage Projects...">&#9636; Manage</button>
  <div class="header-spacer"></div>
  <button onclick="toggleSettingsMenu(this)" title="Settings...">&#9881; Settings</button>
  <button class="icon-btn" id="darkToggleBtn" onclick="toggleDarkMode()" title="Dark Mode">&#9790;</button>
  <button class="icon-btn" id="compactHiddenToggleBtn" onclick="toggleHiddenPlaceholderCompact()" title="Collapse hidden-item rows">&#8862;</button>
  <button class="icon-btn" onclick="relaunchApp()" title="Relaunch (loads the latest saved version of the app)">&#8681;</button>
</div>

<div id="filterBar">
  <label for="fileFilterInput">Files:</label>
  <button id="fileFilterModeBtn" class="filter-mode-btn" onclick="toggleFileFilterMode()" title="Toggle whether files must ALL match (AND) or ANY match (OR)">AND</button>
  <div id="fileFilterBox" class="pill-filter-box"></div>
  <button id="fileFilterClearBtn" type="button" class="pill-filter-clear" onclick="clearFileFilters()" title="Clear file filters">Clear</button>
  <label for="detailFilterInput">Details:</label>
  <input type="text" id="detailFilterInput" oninput="onFilterChanged()" />
  <button onclick="clearDetailFilter()">Clear</button>
  <span id="liveFilterGroup" class="live-filter-group">
    <button type="button" class="live-filter-btn active" data-mode="all" onclick="setLiveFilterMode('all')">All</button>
    <button type="button" class="live-filter-btn" data-mode="live" onclick="setLiveFilterMode('live')">Live only</button>
    <button type="button" class="live-filter-btn" data-mode="test" onclick="setLiveFilterMode('test')">Non-live</button>
  </span>
  <span id="listViewGroup" class="live-filter-group log-only-control" title="Collapse joined/co-deployed rows into one summary row per group">
    <button type="button" class="live-filter-btn active" data-mode="normal" onclick="setListViewMode('normal')">Normal</button>
    <button type="button" class="live-filter-btn" data-mode="grouped" onclick="setListViewMode('grouped')">Grouped</button>
  </span>
  <label class="group-option-checkbox log-only-control" title="Merge a group into one row even when other deploys fall between its members' IDs - only meaningful in Grouped view">
    <input type="checkbox" id="groupMergeGapsCheckbox" onclick="toggleGroupMergeAcrossGaps()" /> Merge gaps
  </label>
  <span class="group-option-label log-only-control">Group precedence:</span>
  <span id="groupClusterBasisGroup" class="live-filter-group log-only-control" title="Which grouping wins when a record is both part of a live-deploy batch and a manual Joined-Entries group - affects Grouped view's row-collapsing and the left-edge accent colour in every view, plus what a click selects.">
    <button type="button" class="live-filter-btn" data-basis="live" onclick="setGroupClusterBasis('live')">Live deployed</button>
    <button type="button" class="live-filter-btn active" data-basis="joined" onclick="setGroupClusterBasis('joined')">Joined items</button>
  </span>
  <span id="resultCount"></span>
</div>

<div id="main">
  <div id="listPane">
    <div class="pane-header-row">
      <span class="pane-view-toggle-wrap">
        <label class="pane-view-toggle-label">Viewing Mode:</label>
        <span class="pane-view-toggle-group">
          <button type="button" id="appViewLogBtn" class="pane-view-toggle-btn active" onclick="setAppViewMode('log')">Deployment Entries</button>
          <button type="button" id="appViewGitBtn" class="pane-view-toggle-btn" onclick="setAppViewMode('git')" title="Switch to the project's git commit history">Git Commits</button>
        </span>
      </span>
      <span class="pane-header-right-group">
        <button id="addNewEntryBtn" class="test-deploy-btn" onclick="startAddNewEntry()">+ New Entry</button>
        <button class="pane-icon-btn" onclick="loadData()" title="Refresh">&#8635;</button>
      </span>
    </div>
    <div id="list"></div>
  </div>
  <div id="resizer"></div>
  <div id="detailsPane">
    <div class="pane-header-row">
      <div class="pane-header-left">
        <h2 class="section">Details</h2>
        <span id="detailsLiveDesc" class="details-live-desc"></span>
      </div>
      <div id="detailsActions" style="display:none;">
        <span id="selectGroupPrefix" class="group-status-text" style="display:none;">This entry is part of a joined set - </span>
        <span id="selectGroupLink" class="git-select-all" style="display:none;" onclick="selectAllEntriesInGroup()">View joined entries combined</span>
        <span id="groupStatusText" class="group-status-text" style="display:none;">You are viewing a joined set</span>
        <span id="groupInfoIcon" class="group-info-icon" style="display:none;" title="Helps mark what needs to be deployed to live together later">ⓘ</span>
        <span id="viewSoloLink" class="git-select-all" style="display:none;" onclick="viewGroupOriginSolo()">View original entry selected, solo</span>
        <button id="groupBtn" class="test-deploy-btn" style="display:none;"></button>
        <button id="editEntryBtn" class="test-deploy-btn" onclick="openEditEntryModal()">Edit...</button>
        <button id="duplicateEntryBtn" class="test-deploy-btn" onclick="openDuplicateEntryModal()">Duplicate...</button>
        <!-- No "..." here on purpose - unlike its siblings, this doesn't open a modal, just a
             plain Y/N confirm() before acting immediately, so it doesn't fit the "opens a
             dialog" convention. Only shown (see updateDetailsActionsVisibility-equivalent logic)
             when the single selected record is still pending, mirroring redeploy-tweaks.ps1's
             own -DeleteLastEntryIfPending refusal to delete anything already deployed. -->
        <button id="deleteEntryBtn" class="test-deploy-btn delete-entry-btn" onclick="deleteEntry()" style="display:none;">Delete</button>
        <button id="testDeployBtn" class="test-deploy-btn" onclick="startTestDeploy()" style="display:none;">Deploy to Test</button>
        <span class="live-options-wrap">
          <button id="liveOptionsBtn" class="test-deploy-btn live-options-btn" onclick="toggleLiveOptionsMenu(this)" style="display:none;">Live Options &#9662;</button>
        </span>
      </div>
    </div>
    <div id="detailsMeta"></div>
    <div id="detailsBody"><div id="empty">Select a row on the left</div></div>
  </div>
  <div id="vresizer"></div>
  <div id="filesPane">
    <div id="filesPaneColumns" class="files-pane-columns">
      <div class="files-pane-list-col">
        <div class="pane-header-row">
          <h2 class="section">Files<span id="filesCount" class="pane-count"></span></h2>
          <div id="filesActionBar" class="files-action-bar" style="display:none;">
            <button id="stageFilesBtn" class="test-deploy-btn files-action-btn" style="display:none;" onclick="stageDisplayedFiles()">Stage these files</button>
            <button id="dbScriptsBtn" class="test-deploy-btn files-action-btn" style="display:none;" onclick="openDbScriptsModal()">DB Scripts...</button>
            <button id="filesSelectAllScriptsBtn" class="test-deploy-btn files-action-btn" style="display:none;" onclick="selectAllDbUpdatesFilesInPane()">Select all scripts</button>
            <span id="filesPerFileActionBar" class="files-action-bar" style="display:none;">
              <button id="filesTagRevertedBtn" class="test-deploy-btn files-action-btn" style="display:none;" onclick="toggleFileReversionForSelectedEntry()">Tag as reverted</button>
            </span>
          </div>
        </div>
        <ul id="filesBody" class="files-pane-list"></ul>
      </div>
      <div class="entries-group-col">
        <div class="pane-header-row">
          <h2 class="section"><span id="entriesGroupHeading">Joined Entries</span><span id="entriesGroupCount" class="pane-count"></span></h2>
        </div>
        <ul id="entriesGroupList" class="entries-group-list"></ul>
      </div>
    </div>
  </div>
</div>

<div id="markLiveOverlay" class="modal-overlay">
  <div id="markLiveBox" class="modal-box" style="width:680px; height:95vh; margin-left:100px; box-sizing:border-box; overflow-y:auto;">
    <h3>Mark as Live Deployed</h3>
    <div id="markLiveFitnessRow" class="mark-live-fitness-row" style="display:none;">
      <span id="markLiveFitnessStatus" class="mark-live-fitness-status"></span>
      <button id="markFitBtn" class="test-deploy-btn fitness-btn-fit" onclick="confirmMarkFitForLive()">Fit for Live</button>
      <button id="markNotFitBtn" class="test-deploy-btn fitness-btn-notfit" onclick="confirmMarkNotFitForLive()">Not Fit for Live</button>
      <button id="clearFitnessBtn" class="test-deploy-btn" onclick="confirmClearFitnessStatus()" style="display:none;">Clear</button>
    </div>
    <div class="mark-live-outer-row">
      <div class="mark-live-columns">
        <div class="mark-live-left">
          <div id="markLiveSummary"></div>
          <div class="mark-live-datetime-row">
            <div class="mark-live-field">
              <label for="markLiveDate">Date</label>
              <input type="date" id="markLiveDate" />
            </div>
            <div class="mark-live-field mark-live-field-time">
              <label for="markLiveTime">Time</label>
              <div class="mark-live-time-wrap">
                <input type="time" id="markLiveTime" maxlength="8" />
                <span class="mark-live-time-clear" title="Clear time to 00:00" onclick="clearMarkLiveTime()">&#10005;</span>
              </div>
            </div>
          </div>
          <div id="markLiveSuggestionsSection">
            <label id="markLiveSuggestionsLabel">Deploy-list suggestions</label>
            <ul id="markLiveSuggestionsList" class="deploy-file-list"></ul>
            <span id="markLiveShowAllToggle" onclick="toggleMarkLiveShowAll()"></span>
          </div>
        </div>
        <div class="mark-live-right">
          <div class="mark-live-right-head">
            <label>Deploy-list details</label>
            <div class="mark-live-right-head-actions">
              <button id="markLiveCompareBtn" class="test-deploy-btn" onclick="runMarkLiveCompare()" disabled>Cross-check</button>
              <button id="markLiveViewBackupBtn" class="test-deploy-btn mark-live-view-backup-btn" onclick="toggleMarkLiveBackupPanel()" disabled>View Backup...</button>
              <button id="markLiveLinkCommitBtn" class="test-deploy-btn" onclick="toggleMarkLiveCommitLinkPanel()" style="display:none;">Link Commit(s)...</button>
            </div>
          </div>
          <div id="markLiveCompareResult" class="mark-live-compare-result" style="display:none;"></div>
          <div id="markLiveFileDetails" class="mark-live-file-details"></div>
        </div>
      </div>
      <div id="markLiveBackupPanel" class="mark-live-backup-panel" style="display:none;"></div>
